# 《驯龙阁》后端配置
# 复制此文件为 .env 并填入真实值
#
# ⚠️ 注意：以下标注 [必填] 的项目没有默认值，
#   缺少任意一项时服务将拒绝启动。请勿将真实值提交到代码仓库。

# ── 微信小程序配置 ──────────────────────────────────────
# [必填] 微信小程序 AppID 和 AppSecret，从微信公众平台获取
WECHAT_APPID=wx_your_appid_here
WECHAT_SECRET=your_appsecret_here

# ── 微信支付配置 (商户号) ────────────────────────────────
WECHAT_MCHID=your_mchid_here
WECHAT_MCHSERIALNO=your_mchserialno_here
WECHAT_MCHAPIV3KEY=your_mchapiv3key_here
WECHAT_MCHPRIVATEKEY=./certs/apiclient_key.pem

# ── 微信云开发配置 (云托管) ─────────────────────────────
TCB_SECRET_ID=your_secret_id_here
TCB_SECRET_KEY=your_secret_key_here
TCB_ENV_ID=your_env_id_here

# ── JWT 配置 ───────────────────────────────────────────
# [必填] 随机字符串，建议至少 32 位，例如：
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_this_to_a_random_32char_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── 数据库配置 ─────────────────────────────────────────
# 本地开发（与 docker-compose.yml 一致）：
DATABASE_URL=mysql+pymysql://xunlongge:local_password@127.0.0.1:3307/xunlongge?charset=utf8mb4
MYSQL_DATABASE=xunlongge
MYSQL_USER=xunlongge
MYSQL_PASSWORD=local_password
MYSQL_ROOT_PASSWORD=local_root_password
# 微信云托管生产环境（在控制台设置，禁止把真实密码提交到仓库）：
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@MYSQL_PRIVATE_HOST:3306/xunlongge?charset=utf8mb4

# ── 服务器配置 ─────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=true
ENVIRONMENT=development
