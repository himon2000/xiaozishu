<!-- custom-tab-bar/index.wxml -->
<view class="tab-bar-wrapper">
  <!-- 背景 -->
  <view class="tab-bar-bg"></view>

  <!-- TabBar -->
  <view class="tab-bar">
    <!-- 首页 -->
    <view
      class="tab-item {{selected === 0 ? 'active' : ''}}"
      data-index="0"
      bindtap="onTabTap"
    >
      <view class="tab-icon">
        <image src="{{selected === 0 ? '/assets/tab-home-active.png' : '/assets/tab-home.png'}}" mode="aspectFit" />
      </view>
      <text class="tab-text">首页</text>
    </view>

    <!-- 服务广场 -->
    <view
      class="tab-item {{selected === 1 ? 'active' : ''}}"
      data-index="1"
      bindtap="onTabTap"
    >
      <view class="tab-icon">
        <image src="{{selected === 1 ? '/assets/tab-plaza-active.png' : '/assets/tab-plaza.png'}}" mode="aspectFit" />
      </view>
      <text class="tab-text">服务广场</text>
    </view>

    <!-- 中间"+"按钮 -->
    <view class="tab-center" bindtap="onCreateTap">
      <view class="create-btn">
        <text class="create-icon">+</text>
      </view>
    </view>

    <!-- 我的订单 -->
    <view
      class="tab-item {{selected === 2 ? 'active' : ''}}"
      data-index="2"
      bindtap="onTabTap"
    >
      <view class="tab-icon">
        <image src="{{selected === 2 ? '/assets/tab-order-active.png' : '/assets/tab-order.png'}}" mode="aspectFit" />
      </view>
      <text class="tab-text">我的订单</text>
    </view>

    <!-- 个人中心 -->
    <view
      class="tab-item {{selected === 3 ? 'active' : ''}}"
      data-index="3"
      bindtap="onTabTap"
    >
      <view class="tab-icon">
        <image src="{{selected === 3 ? '/assets/tab-profile-active.png' : '/assets/tab-profile.png'}}" mode="aspectFit" />
      </view>
      <text class="tab-text">我的</text>
    </view>
  </view>

  <!-- 底部安全区占位 -->
  <view class="safe-area-placeholder"></view>
</view>

<!-- 创建弹窗 -->
<view class="create-modal {{showCreateModal ? 'show' : ''}}" bindtap="onModalClose">
  <view class="create-sheet" catchtap="">
    <view class="sheet-header">
      <text class="sheet-title">发布内容</text>
      <view class="sheet-close" bindtap="onModalClose">✕</view>
    </view>

    <view class="create-options">
      <view
        class="create-option"
        wx:for="{{createOptions}}"
        wx:key="id"
        bindtap="onCreateSelect"
        data-type="{{item.id}}"
      >
        <view class="option-icon">{{item.icon}}</view>
        <view class="option-info">
          <view class="option-name">{{item.name}}</view>
          <view class="option-desc">{{item.desc}}</view>
        </view>
      </view>
    </view>

    <view class="sheet-footer" bindtap="onModalClose">
      <text>取消</text>
    </view>
  </view>
</view>
