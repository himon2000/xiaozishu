/* pages/home/home.wxss - 小红书风格首页样式 */

/* ========== 页面基础 ========== */
.page {
  min-height: 100vh;
  background: #faf7ff;
}

/* ========== 导航栏 ========== */
.nav-bar {
  background: linear-gradient(135deg, #9b59b6, #8e44ad);
  padding: 20rpx 30rpx;
}
.nav-inner { text-align: center; }
.nav-title { font-size: 36rpx; font-weight: 700; color: #fff; }

/* ========== 搜索栏 ========== */
.search-section { padding: 20rpx 30rpx; background: #fff; }
.search-bar {
  display: flex;
  align-items: center;
  height: 72rpx;
  background: #f5f0fa;
  border-radius: 36rpx;
  padding: 0 24rpx;
}
.search-icon { font-size: 28rpx; margin-right: 12rpx; }
.search-hint { font-size: 26rpx; color: #b8a9c9; }

/* ========== Banner ========== */
.hero-banner {
  margin: 20rpx 30rpx;
  padding: 40rpx;
  background: linear-gradient(135deg, #9b59b6, #8e44ad);
  border-radius: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.banner-content { color: #fff; }
.banner-main { font-size: 36rpx; font-weight: 700; }
.banner-sub { font-size: 24rpx; margin-top: 8rpx; opacity: 0.9; }
.banner-badge {
  font-size: 22rpx;
  color: #9b59b6;
  background: #fff;
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
}

/* ========== 6大功能模块 ========== */
.module-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 20rpx;
  margin-bottom: 20rpx;
}
.module-card {
  width: 33.33%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 10rpx;
  box-sizing: border-box;
}
.module-icon { font-size: 56rpx; margin-bottom: 8rpx; }
.module-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 4rpx;
}
.module-desc {
  font-size: 20rpx;
  color: #999;
  text-align: center;
}

/* ========== 信息流（小红书瀑布流） ========== */
.feed-section {
  padding: 20rpx;
}

.feed-header {
  margin-bottom: 20rpx;
}
.feed-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
}

.feed-grid {
  display: flex;
  justify-content: space-between;
}

.feed-column {
  width: 48.5%;
}

.feed-card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(155, 89, 182, 0.08);
}

.feed-card.hidden { display: none; }

.card-image {
  width: 100%;
  background: #f5f0fa;
}

.card-content {
  padding: 16rpx;
}

.card-title {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.card-tags {
  display: flex;
  margin-top: 10rpx;
}

.card-tags .tag {
  font-size: 20rpx;
  color: #9b59b6;
  margin-right: 12rpx;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #f5f0fa;
}

.author-info {
  display: flex;
  align-items: center;
}

.author-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  margin-right: 8rpx;
  background: #f5f0fa;
}

.author-name {
  font-size: 20rpx;
  color: #666;
}

.card-stats {
  display: flex;
  gap: 12rpx;
}

.stat-item {
  font-size: 20rpx;
  color: #999;
}

/* ========== 热门服务 ========== */
.hot-services-section {
  padding: 20rpx 0;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 30rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.section-more {
  font-size: 24rpx;
  color: #9b59b6;
}

.horizontal-scroll {
  white-space: nowrap;
  padding: 0 30rpx;
}

.service-card {
  display: inline-block;
  width: 220rpx;
  margin-right: 20rpx;
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  vertical-align: top;
}

.service-cover {
  width: 100%;
  height: 220rpx;
  background: #f5f0fa;
}

.service-info {
  padding: 12rpx;
}

.service-title {
  font-size: 24rpx;
  font-weight: 500;
  color: #333;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.service-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 10rpx;
}

.service-price {
  font-size: 26rpx;
  font-weight: 700;
  color: #9b59b6;
}

.service-rating {
  font-size: 20rpx;
  color: #999;
}

/* ========== 优秀大虾 ========== */
.provider-card {
  display: inline-block;
  width: 160rpx;
  margin-right: 20rpx;
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  text-align: center;
  vertical-align: top;
}

.provider-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin: 0 auto 12rpx;
  background: #f5f0fa;
}

.provider-info { }

.provider-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
}

.provider-level {
  font-size: 20rpx;
  color: #9b59b6;
  background: rgba(155, 89, 182, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  display: inline-block;
  margin: 8rpx 0;
}

.provider-rating {
  font-size: 20rpx;
  color: #999;
}

/* ========== 热门需求 ========== */
.demand-list {
  padding: 0 30rpx;
}

.demand-item {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(155, 89, 182, 0.08);
}

.demand-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.demand-type {
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  background: rgba(155, 89, 182, 0.1);
  color: #9b59b6;
}

.demand-budget {
  font-size: 28rpx;
  font-weight: 700;
  color: #9b59b6;
}

.demand-title {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 12rpx;
}

.demand-footer {
  display: flex;
  justify-content: space-between;
  font-size: 20rpx;
  color: #999;
}

/* ========== 加载状态 ========== */
.loading-more {
  text-align: center;
  padding: 30rpx;
  font-size: 24rpx;
  color: #999;
}

.no-more {
  text-align: center;
  padding: 40rpx;
  font-size: 24rpx;
  color: #b8a9c9;
}

/* ========== 安全区 ========== */
.safe-area-bottom {
  height: 120rpx;
}
