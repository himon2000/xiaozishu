/* pages/dispute-apply/dispute-apply.wxss */
.page {
  min-height: 100vh;
  background: var(--bg);
  padding: 24rpx;
  padding-bottom: 200rpx;
}

/* 提示卡片 */
.notice-card {
  background: rgba(52, 152, 219, 0.1);
  border: 1rpx solid rgba(52, 152, 219, 0.3);
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.notice-icon {
  font-size: 36rpx;
  flex-shrink: 0;
}

.notice-text {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.notice-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #3498db;
}

.notice-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

/* 表单卡片 */
.form-card {
  background: var(--surface);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--border);
}

.form-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 20rpx;
}

.required {
  color: #ff4757;
}

.optional {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--text-secondary);
}

/* 单选项 */
.radio-group {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.radio-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 20rpx;
  background: var(--bg);
  border-radius: 12rpx;
  border: 1rpx solid var(--border);
  transition: all 0.2s;
}

.radio-item.selected {
  background: rgba(155, 89, 182, 0.1);
  border-color: var(--primary);
}

.radio-circle {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.radio-item.selected .radio-circle {
  border-color: var(--primary);
}

.radio-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: var(--primary);
}

.radio-label {
  font-size: 28rpx;
  color: var(--text);
}

/* 文本域 */
.textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx;
  background: var(--bg);
  border-radius: 12rpx;
  border: 1rpx solid var(--border);
  font-size: 28rpx;
  color: var(--text);
  box-sizing: border-box;
  line-height: 1.6;
}

.char-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 12rpx;
}

/* 上传区域 */
.upload-area {
  margin-top: 8rpx;
}

.upload-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.upload-item {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
  position: relative;
}

.upload-img {
  width: 100%;
  height: 100%;
}

.upload-remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 32rpx;
}

.upload-btn {
  width: 200rpx;
  height: 200rpx;
  background: var(--bg);
  border: 2rpx dashed var(--border);
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.upload-icon {
  font-size: 48rpx;
  color: var(--text-secondary);
}

.upload-text {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.upload-hint {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 16rpx;
}

/* 提交区域 */
.submit-area {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--surface);
  border-top: 1rpx solid var(--border);
  padding: 24rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  z-index: 100;
}

.submit-hint {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.btn-primary {
  width: 100%;
  padding: 24rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, var(--primary), var(--accent));
  border-radius: 40rpx;
  border: none;
}

.btn-primary:active {
  opacity: 0.9;
}

.btn-primary[loading] {
  opacity: 0.7;
}
