/* pages/review-list/review-list.wxss */

/* 评分概览 */
.stats-card {
  padding: 30rpx;
  margin: 20rpx;
  background: linear-gradient(135deg, #9b59b6, #7d3c98);
  color: #fff;
  border-radius: 20rpx;
}

.stats-main {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.stats-score {
  font-size: 80rpx;
  font-weight: bold;
  margin-right: 20rpx;
}

.stats-info {
  display: flex;
  flex-direction: column;
}

.stars-row {
  display: flex;
}

.star {
  font-size: 28rpx;
  color: rgba(255,255,255,0.4);
}

.star-active {
  color: #ffd700;
}

.stats-count {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 8rpx;
}

/* 评分分布 */
.rating-dist {
  background: rgba(255,255,255,0.15);
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.dist-item {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.dist-item:last-child {
  margin-bottom: 0;
}

.dist-label {
  width: 60rpx;
  font-size: 22rpx;
  opacity: 0.9;
}

.dist-bar-wrap {
  flex: 1;
  height: 12rpx;
  background: rgba(255,255,255,0.3);
  border-radius: 6rpx;
  margin: 0 16rpx;
  overflow: hidden;
}

.dist-bar {
  height: 100%;
  background: #ffd700;
  border-radius: 6rpx;
  transition: width 0.3s;
}

.dist-count {
  width: 50rpx;
  font-size: 22rpx;
  text-align: right;
}

/* 热门标签 */
.hot-tags-title {
  font-size: 26rpx;
  opacity: 0.9;
  margin-bottom: 12rpx;
  display: block;
}

.tags-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.hot-tag {
  padding: 8rpx 16rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 20rpx;
  font-size: 24rpx;
}

/* 评价卡片 */
.review-list {
  padding: 0 20rpx 20rpx;
}

.review-card {
  padding: 24rpx;
  margin-bottom: 20rpx;
  background: #fff;
  border-radius: 16rpx;
}

.reviewer-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.reviewer-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.reviewer-info {
  flex: 1;
}

.reviewer-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.reviewer-level {
  font-size: 22rpx;
  color: #9b59b6;
  margin-top: 4rpx;
}

.review-rating {
  display: flex;
}

.star-small {
  color: #ff9800;
  font-size: 24rpx;
  margin-left: 4rpx;
}

.review-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.review-tags {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 16rpx;
}

.mini-tag {
  padding: 4rpx 12rpx;
  margin-right: 8rpx;
  background: #f3e5f5;
  color: #7b1fa2;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.review-images {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.review-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
}

/* 商家回复 */
.provider-reply {
  background: #f8f8f8;
  padding: 16rpx;
  border-radius: 8rpx;
  margin-bottom: 12rpx;
}

.reply-label {
  color: #9b59b6;
  font-size: 26rpx;
  font-weight: bold;
}

.reply-content {
  color: #666;
  font-size: 26rpx;
  line-height: 1.5;
}

.review-time {
  font-size: 24rpx;
  color: #999;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
}

.empty-state .icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
}

.empty-state text {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.text-secondary {
  color: #999;
  font-size: 26rpx !important;
}

.loading-container {
  display: flex;
  justify-content: center;
  padding: 40rpx;
  color: #999;
  font-size: 26rpx;
}
