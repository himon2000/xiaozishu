/* pages/profile/profile.wxss - 我的页面 列表菜单式 */

/* ========== 页面基础 ========== */
.page {
  min-height: 100vh;
  background: #f5f0fa;
  padding-bottom: 140rpx;
}

.loading-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #f0ebf7;
  border-top-color: #9b59b6;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

.loading-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #999;
}

/* ========== 用户信息卡片 ========== */
.profile-header-card {
  background: linear-gradient(145deg, #9b59b6, #8e44ad);
  padding: 48rpx 30rpx 36rpx;
  color: #fff;
  box-shadow: 0 4rpx 20rpx rgba(139, 92, 246, 0.2);
}

.profile-row {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  flex-shrink: 0;
}

.profile-info {
  flex: 1;
  min-width: 0;
}

.profile-name-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.profile-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}

.level-badge {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.2);
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  gap: 4rpx;
}

.level-icon {
  font-size: 22rpx;
}

.level-name {
  font-size: 22rpx;
  color: #fff;
}

.profile-school {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
  margin-top: 8rpx;
}

.profile-stats-row {
  display: flex;
  align-items: center;
  gap: 0;
  margin-top: 16rpx;
}

.mini-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 20rpx;
}

.mini-stat:first-child {
  padding-left: 0;
}

.mini-num {
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
}

.mini-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.75);
  margin-top: 2rpx;
}

.mini-sep {
  width: 1rpx;
  height: 32rpx;
  background: rgba(255, 255, 255, 0.3);
}

.edit-btn {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  background: rgba(255, 255, 255, 0.18);
  padding: 10rpx 22rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  margin-top: 8rpx;
}

/* ========== 分组标签 ========== */
.group-label {
  font-size: 24rpx;
  color: #9b59b6;
  font-weight: 600;
  padding: 28rpx 32rpx 10rpx;
  letter-spacing: 1rpx;
}

/* ========== 菜单分组 ========== */
.menu-group {
  background: #fff;
  margin: 0 24rpx 8rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(155, 89, 182, 0.07);
}

.settings-group {
  margin-top: 0;
}

/* ========== 菜单项 ========== */
.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 28rpx;
  border-bottom: 1rpx solid #f5f0fa;
  position: relative;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 36rpx;
  width: 56rpx;
  flex-shrink: 0;
  text-align: center;
}

.menu-title {
  flex: 1;
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  margin-left: 8rpx;
}

.menu-note {
  font-size: 24rpx;
  color: #bbb;
  margin-right: 10rpx;
}

.menu-arrow {
  font-size: 32rpx;
  color: #ccc;
}

/* ========== 待办角标 ========== */
.badge-dot {
  min-width: 36rpx;
  height: 36rpx;
  background: #ff4757;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
  margin-right: 10rpx;
  box-sizing: border-box;
}

.badge-text {
  font-size: 20rpx;
  color: #fff;
  font-weight: 700;
  line-height: 1;
}

/* ========== 危险项（退出登录） ========== */
.menu-item.danger .menu-title,
.danger-text {
  color: #ff4757 !important;
}

.danger-arrow {
  color: #ffb3bb !important;
}

/* ========== 安全区 ========== */
.safe-area-bottom {
  height: 120rpx;
}
