/* pages/publish-service/publish-service.wxss */

/* 通用样式 */
.page {
  min-height: 100vh;
  background: var(--bg, #f5f5f5);
  padding: 24rpx;
  padding-bottom: 180rpx;
}

.notice-card {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.notice-icon {
  font-size: 48rpx;
  flex-shrink: 0;
}

.notice-text {
  flex: 1;
}

.notice-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 8rpx;
}

.notice-desc {
  font-size: 24rpx;
  color: rgba(255,255,255,0.9);
  line-height: 1.5;
}

.form-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.form-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.required {
  color: #e74c3c;
}

.optional {
  color: #999;
  font-weight: normal;
  font-size: 24rpx;
}

.input-field {
  width: 100%;
  height: 80rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.textarea {
  width: 100%;
  height: 200rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.char-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 服务类型选择 */
.service-type-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.service-type-item {
  padding: 20rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  text-align: center;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.service-type-item.selected {
  background: #f0e6ff;
  border-color: #9b59b6;
}

.type-icon {
  display: block;
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.type-name {
  display: block;
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
}

.type-desc {
  display: block;
  font-size: 20rpx;
  color: #999;
  margin-top: 4rpx;
}

/* 科目选择 */
.selected-subjects {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.subject-tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 16rpx;
  background: #f0e6ff;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #9b59b6;
}

.subject-tag.selected {
  background: #9b59b6;
  color: #fff;
}

.tag-remove {
  margin-left: 8rpx;
  font-size: 28rpx;
}

.choose-btn {
  padding: 16rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  text-align: center;
  font-size: 28rpx;
  color: #666;
}

/* 封面图片 */
.upload-area {
  display: flex;
  justify-content: center;
}

.upload-preview {
  position: relative;
  width: 300rpx;
  height: 200rpx;
}

.cover-preview {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.remove-btn {
  position: absolute;
  top: -16rpx;
  right: -16rpx;
  width: 48rpx;
  height: 48rpx;
  background: #e74c3c;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.upload-btn-cover {
  width: 300rpx;
  height: 200rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #ddd;
}

.upload-icon {
  font-size: 64rpx;
  margin-bottom: 8rpx;
}

.upload-text {
  font-size: 24rpx;
  color: #999;
}

/* 战绩列表 */
.achievement-list {
  margin-bottom: 16rpx;
}

.achievement-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

.achievement-level {
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  color: #fff;
}

.achievement-name {
  flex: 1;
  font-size: 26rpx;
  color: #333;
}

.achievement-year {
  font-size: 22rpx;
  color: #999;
}

.delete-btn {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #e74c3c;
  font-size: 32rpx;
}

.add-btn {
  padding: 16rpx;
  background: #f0e6ff;
  border-radius: 12rpx;
  text-align: center;
  font-size: 28rpx;
  color: #9b59b6;
}

/* 案例列表 */
.case-list {
  margin-bottom: 16rpx;
}

.case-item {
  padding: 16rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

.case-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.case-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
}

.case-desc {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-top: 8rpx;
}

.case-result {
  display: block;
  font-size: 24rpx;
  color: #27ae60;
  margin-top: 8rpx;
}

/* 教学风格 */
.style-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.style-chip {
  padding: 12rpx 24rpx;
  background: #f5f5f5;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #666;
  border: 2rpx solid transparent;
}

.style-chip.selected {
  background: #f0e6ff;
  border-color: #9b59b6;
  color: #9b59b6;
}

/* 交付方式 */
.method-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.method-item {
  padding: 20rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  border: 2rpx solid transparent;
}

.method-item.selected {
  background: #f0e6ff;
  border-color: #9b59b6;
}

.method-icon {
  font-size: 40rpx;
}

.method-name {
  font-size: 24rpx;
  color: #666;
}

/* 定价 */
.pricing-modes {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.pricing-mode {
  flex: 1;
  padding: 16rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  text-align: center;
  font-size: 26rpx;
  color: #666;
  border: 2rpx solid transparent;
}

.pricing-mode.selected {
  background: #f0e6ff;
  border-color: #9b59b6;
  color: #9b59b6;
}

.price-input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.price-input {
  flex: 1;
  height: 80rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 32rpx;
}

.price-unit {
  font-size: 24rpx;
  color: #999;
}

/* 提交按钮 */
.submit-area {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx;
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.1);
}

.submit-area .btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #9b59b6 0%, #8e44ad 100%);
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 弹窗样式 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
}

.modal-content {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80%;
  max-height: 80vh;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
}

.modal-bottom {
  top: auto;
  bottom: 0;
  left: 0;
  right: 0;
  transform: none;
  width: 100%;
  max-height: 70vh;
  border-radius: 24rpx 24rpx 0 0;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #eee;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: 40rpx;
  color: #999;
}

.modal-body {
  padding: 24rpx;
  max-height: 50vh;
  overflow-y: auto;
}

.modal-footer {
  padding: 24rpx;
  border-top: 1rpx solid #eee;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.selected-count {
  flex: 1;
  font-size: 24rpx;
  color: #999;
}

/* 科目选择弹窗 */
.subject-category-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.category-tab {
  padding: 12rpx 24rpx;
  background: #f5f5f5;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #666;
}

.category-tab.active {
  background: #9b59b6;
  color: #fff;
}

.subject-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.subject-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  background: #f5f5f5;
  border-radius: 24rpx;
  font-size: 26rpx;
  border: 2rpx solid transparent;
}

.subject-chip.selected {
  background: #f0e6ff;
  border-color: #9b59b6;
}

.chip-icon {
  font-size: 28rpx;
}

.chip-name {
  color: #333;
}

.chip-check {
  color: #9b59b6;
  font-weight: bold;
}

/* 战绩/案例弹窗 */
.form-item {
  margin-bottom: 24rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.level-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.level-chip {
  padding: 12rpx 20rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #666;
  border: 2rpx solid transparent;
}

.level-chip.selected {
  background: #f0e6ff;
  border-color: #9b59b6;
  color: #9b59b6;
}
