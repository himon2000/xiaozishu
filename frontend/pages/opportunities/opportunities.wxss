/* pages/opportunities/opportunities.wxss */

.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #f8f4fc 0%, #f0e6f7 100%);
  padding-bottom: 120rpx;
}

/* 页面头部 */
.page-header {
  padding: 30rpx 30rpx 20rpx;
  text-align: center;
}

.page-title {
  display: block;
  font-size: 44rpx;
  font-weight: bold;
  color: #7d3c98;
}

.page-subtitle {
  display: block;
  font-size: 26rpx;
  color: #9b59b6;
  margin-top: 8rpx;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  padding: 0 30rpx 20rpx;
  gap: 10rpx;
}

.search-input {
  flex: 1;
  height: 72rpx;
  background: #fff;
  border-radius: 36rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
  box-shadow: 0 4rpx 12rpx rgba(155, 89, 182, 0.1);
}

.search-btn, .filter-btn {
  width: 72rpx;
  height: 72rpx;
  background: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  box-shadow: 0 4rpx 12rpx rgba(155, 89, 182, 0.1);
  padding: 0;
  border: none;
}

/* 分组切换 */
.group-tabs {
  display: flex;
  padding: 0 30rpx;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.group-tab {
  flex: 1;
  height: 80rpx;
  background: #fff;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #666;
  transition: all 0.3s;
}

.group-tab.active {
  background: linear-gradient(135deg, #9b59b6, #8e44ad);
  color: #fff;
  box-shadow: 0 8rpx 20rpx rgba(155, 89, 182, 0.3);
}

/* 分类滚动 */
.category-scroll {
  white-space: nowrap;
  padding: 0 30rpx 20rpx;
}

.category-list {
  display: flex;
  gap: 16rpx;
}

.category-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #fff;
  border-radius: 20rpx;
  min-width: 120rpx;
  transition: all 0.3s;
}

.category-item.active {
  background: linear-gradient(135deg, #9b59b6, #8e44ad);
  color: #fff;
  box-shadow: 0 8rpx 20rpx rgba(155, 89, 182, 0.3);
}

.category-item.hidden {
  display: none;
}

.cat-icon {
  font-size: 36rpx;
  margin-bottom: 4rpx;
}

.cat-name {
  font-size: 22rpx;
  white-space: nowrap;
}

/* 筛选状态 */
.filter-status {
  display: flex;
  align-items: center;
  padding: 0 30rpx 20rpx;
  gap: 10rpx;
  flex-wrap: wrap;
}

.filter-tag {
  background: #f3e5f5;
  color: #7d3c98;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.filter-reset {
  color: #9b59b6;
  font-size: 24rpx;
  padding: 6rpx 16rpx;
}

/* 操作栏 */
.action-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 30rpx 20rpx;
}

.result-count {
  font-size: 26rpx;
  color: #666;
}

.publish-btn {
  background: linear-gradient(135deg, #9b59b6, #8e44ad);
  color: #fff;
  border-radius: 30rpx;
  padding: 0 30rpx;
  height: 60rpx;
  line-height: 60rpx;
  font-size: 26rpx;
  box-shadow: 0 8rpx 20rpx rgba(155, 89, 182, 0.3);
}

.publish-btn::after {
  border: none;
}

/* 资源卡片 */
.opportunity-list {
  padding: 0 30rpx;
}

.opportunity-card {
  margin-bottom: 24rpx;
  padding: 28rpx;
}

.opp-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.opp-type {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  background: #f3e5f5;
  color: #7d3c98;
}

.tag-internship { background: #e8f5e9; color: #2e7d32; }
.tag-referral { background: #fff3e0; color: #e65100; }
.tag-job { background: #e3f2fd; color: #1565c0; }
.tag-job_resource { background: #fce4ec; color: #c2185b; }

.opp-favorite {
  padding: 8rpx;
}

.fav-icon {
  font-size: 32rpx;
}

.fav-icon.active {
  color: #e91e63;
}

.opp-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
  line-height: 1.4;
}

.opp-company {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.company-icon {
  font-size: 24rpx;
}

.company-industry {
  color: #999;
  font-size: 24rpx;
}

.opp-position {
  display: flex;
  gap: 20rpx;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.opp-salary {
  margin-bottom: 12rpx;
}

.salary-tag {
  background: linear-gradient(135deg, #ff6b6b, #ee5a6f);
  color: #fff;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: bold;
}

.opp-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.mini-tag {
  background: #f3e5f5;
  color: #7d3c98;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
}

.opp-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0e6f7;
}

.opp-stats {
  display: flex;
  gap: 20rpx;
}

.stat {
  font-size: 24rpx;
  color: #999;
}

.opp-time {
  font-size: 24rpx;
  color: #999;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 80rpx 0;
}

.empty-state .icon {
  font-size: 100rpx;
  display: block;
  margin-bottom: 20rpx;
}

.empty-state text {
  display: block;
  color: #666;
  margin-bottom: 10rpx;
}

.text-secondary {
  color: #999;
  font-size: 26rpx;
}

.publish-btn-lg {
  margin-top: 30rpx;
  background: linear-gradient(135deg, #9b59b6, #8e44ad);
  color: #fff;
  border-radius: 40rpx;
  width: 300rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
}

.publish-btn-lg::after {
  border: none;
}

/* 加载状态 */
.loading-container {
  text-align: center;
  padding: 30rpx 0;
  color: #999;
  font-size: 26rpx;
}

/* 筛选面板 */
.filter-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.filter-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.filter-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 30rpx 30rpx 0 0;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
}

.filter-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0e6f7;
}

.filter-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.filter-close {
  font-size: 40rpx;
  color: #999;
  padding: 10rpx;
}

.filter-body {
  flex: 1;
  overflow-y: auto;
  padding: 20rpx 30rpx;
}

.filter-section {
  margin-bottom: 30rpx;
}

.filter-section-title {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
}

.filter-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.filter-option {
  padding: 12rpx 24rpx;
  background: #f5f5f5;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
  transition: all 0.3s;
}

.filter-option.active {
  background: #7d3c98;
  color: #fff;
}

.filter-footer {
  display: flex;
  gap: 20rpx;
  padding: 30rpx;
  border-top: 1rpx solid #f0e6f7;
}

.filter-reset-btn, .filter-apply-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.filter-reset-btn {
  background: #f5f5f5;
  color: #666;
}

.filter-apply-btn {
  background: linear-gradient(135deg, #9b59b6, #8e44ad);
  color: #fff;
}

.filter-reset-btn::after, .filter-apply-btn::after {
  border: none;
}

/* 创建弹窗 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 90%;
  max-height: 85vh;
  background: #fff;
  border-radius: 30rpx;
  display: flex;
  flex-direction: column;
}

.create-modal {
  width: 95%;
  max-height: 90vh;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0e6f7;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: 40rpx;
  color: #999;
  padding: 10rpx;
}

.modal-body {
  flex: 1;
  overflow-y: auto;
  padding: 20rpx 30rpx;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 30rpx;
  border-top: 1rpx solid #f0e6f7;
}

.cancel-btn, .confirm-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.cancel-btn {
  background: #f5f5f5;
  color: #666;
}

.confirm-btn {
  background: linear-gradient(135deg, #9b59b6, #8e44ad);
  color: #fff;
}

.cancel-btn::after, .confirm-btn::after {
  border: none;
}

/* 表单项 */
.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  height: 72rpx;
  background: #f8f4fc;
  border-radius: 20rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  background: #f8f4fc;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-picker {
  height: 72rpx;
  background: #f8f4fc;
  border-radius: 20rpx;
  padding: 0 24rpx;
  line-height: 72rpx;
  font-size: 28rpx;
}

.form-picker.placeholder {
  color: #999;
}

.tag-input-wrap {
  display: flex;
  gap: 10rpx;
}

.tag-input {
  flex: 1;
}

.add-tag-btn {
  background: #f3e5f5;
  color: #7d3c98;
  border-radius: 20rpx;
  font-size: 24rpx;
  padding: 0 20rpx;
}

.add-tag-btn::after {
  border: none;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.tag-item {
  display: flex;
  align-items: center;
  background: #f3e5f5;
  color: #7d3c98;
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
}

.tag-remove {
  margin-left: 8rpx;
  color: #999;
}
