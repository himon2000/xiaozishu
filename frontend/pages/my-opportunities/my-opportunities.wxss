/* pages/my-opportunities/my-opportunities.wxss */

.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #f8f4fc 0%, #f0e6f7 100%);
  padding-bottom: 120rpx;
}

/* 标签栏 */
.tab-bar {
  display: flex;
  background: #fff;
  padding: 0 20rpx;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
  transition: all 0.3s;
}

.tab-item.active {
  color: #7d3c98;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background: linear-gradient(135deg, #9b59b6, #8e44ad);
  border-radius: 3rpx;
}

/* 列表容器 */
.list-container {
  padding: 24rpx;
}

/* 卡片 */
.item-card {
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.item-type {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  background: #f3e5f5;
  color: #7d3c98;
}

.tag-internship { background: #e8f5e9; color: #2e7d32; }
.tag-referral { background: #fff3e0; color: #e65100; }
.tag-job { background: #e3f2fd; color: #1565c0; }
.tag-job_resource { background: #fce4ec; color: #c2185b; }

.item-status {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.status-active { background: #e8f5e9; color: #2e7d32; }
.status-closed { background: #f5f5f5; color: #999; }
.status-expired { background: #fff3e0; color: #e65100; }

.application-status { }
.application-status.status-pending { background: #fff3e0; color: #e65100; }
.application-status.status-accepted { background: #e8f5e9; color: #2e7d32; }
.application-status.status-rejected { background: #ffebee; color: #c62828; }
.application-status.status-withdrawn { background: #f5f5f5; color: #999; }

.item-favorite {
  font-size: 32rpx;
}

.item-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
  line-height: 1.4;
}

.item-company {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.item-salary {
  margin-bottom: 12rpx;
}

.salary-tag {
  background: linear-gradient(135deg, #ff6b6b, #ee5a6f);
  color: #fff;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: bold;
}

.item-stats {
  display: flex;
  gap: 24rpx;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.item-message {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 12rpx;
  padding: 16rpx;
  background: #f8f4fc;
  border-radius: 12rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.item-time {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.item-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0e6f7;
}

.action-btn {
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 24rpx;
  background: #f5f5f5;
  color: #666;
  border-radius: 28rpx;
  font-size: 24rpx;
}

.action-btn.withdraw {
  background: #fff3e0;
  color: #e65100;
}

.action-btn::after {
  border: none;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  display: block;
  margin-bottom: 24rpx;
}

.empty-text {
  display: block;
  font-size: 28rpx;
  color: #999;
  margin-bottom: 30rpx;
}

.empty-btn {
  background: linear-gradient(135deg, #9b59b6, #8e44ad);
  color: #fff;
  border-radius: 40rpx;
  width: 280rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
}

.empty-btn::after {
  border: none;
}

/* 加载状态 */
.loading-container {
  text-align: center;
  padding: 30rpx 0;
  color: #999;
  font-size: 26rpx;
}

.text-secondary {
  color: #999;
}
