/* 万务仙坊 - 服务广场 */
.page {
  min-height: 100vh;
  background: var(--bg);
  padding: 24rpx 24rpx 120rpx;
}

/* ===== 搜索栏 ===== */
.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: var(--surface);
  border: 1.5rpx solid var(--border);
  border-radius: 48rpx;
  padding: 14rpx 24rpx;
  gap: 12rpx;
}

.search-icon {
  font-size: 28rpx;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text);
  background: transparent;
}

.clear-btn {
  font-size: 26rpx;
  color: var(--text-secondary);
  padding: 0 4rpx;
  flex-shrink: 0;
}

.filter-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 24rpx;
  background: var(--surface);
  border: 1.5rpx solid var(--border);
  border-radius: 48rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  white-space: nowrap;
  flex-shrink: 0;
}

.filter-btn-active {
  background: rgba(155, 89, 182, 0.12);
  border-color: var(--primary);
  color: var(--primary);
}

/* ===== 分类标签横滚 ===== */
.category-scroll {
  margin-bottom: 16rpx;
  white-space: nowrap;
}

.category-list {
  display: inline-flex;
  gap: 16rpx;
  padding: 4rpx 0 12rpx;
}

.category-tag {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 28rpx;
  background: var(--surface);
  border: 1.5rpx solid var(--border);
  border-radius: 32rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  white-space: nowrap;
  transition: all 0.2s;
}

.category-tag.active {
  background: var(--primary);
  border-color: var(--primary);
  color: #fff;
  font-weight: 600;
}

/* ===== 传功授法科目筛选 ===== */
.subject-filter-bar {
  background: var(--surface);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid var(--border);
}

.filter-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.filter-row:last-child {
  margin-bottom: 0;
}

.filter-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  flex-shrink: 0;
  width: 70rpx;
}

.filter-scroll {
  flex: 1;
  white-space: nowrap;
}

.filter-tags {
  display: inline-flex;
  gap: 12rpx;
}

.filter-tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 18rpx;
  background: var(--bg);
  border: 1.5rpx solid var(--border);
  border-radius: 20rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
  white-space: nowrap;
}

.filter-tag.active {
  background: rgba(155, 89, 182, 0.12);
  border-color: var(--primary);
  color: var(--primary);
}

/* ===== 筛选面板 ===== */
.filter-panel {
  background: var(--surface);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid var(--border);
}

.filter-section {
  margin-bottom: 24rpx;
}

.filter-title {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 14rpx;
  font-weight: 500;
}

.filter-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.filter-chip {
  padding: 10rpx 22rpx;
  background: var(--bg);
  border: 1.5rpx solid var(--border);
  border-radius: 24rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.filter-chip.active {
  background: var(--primary);
  color: #fff;
  border-color: var(--primary);
}

.filter-actions {
  display: flex;
  gap: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border);
}

.reset-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  background: var(--bg);
  color: var(--text-secondary);
  border: 1.5rpx solid var(--border);
  border-radius: 40rpx;
  font-size: 28rpx;
}

.confirm-btn {
  flex: 2;
  text-align: center;
  padding: 18rpx 0;
  background: var(--primary);
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
}

/* ===== 统计条 ===== */
.stats-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  min-height: 48rpx;
}

.active-filters {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

.active-tag {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 16rpx;
  background: rgba(155, 89, 182, 0.12);
  color: var(--primary);
  border-radius: 20rpx;
  font-size: 22rpx;
}

.tag-close {
  font-size: 20rpx;
  opacity: 0.7;
}

.stats-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  white-space: nowrap;
}

/* ===== 服务列表（单列横向布局） ===== */
.service-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 服务卡片 - 单列横向 */
.service-card {
  display: flex;
  flex-direction: row;
  background: var(--surface);
  border-radius: 16rpx;
  overflow: hidden;
  border: 1rpx solid var(--border);
  position: relative;
  transition: transform 0.15s, box-shadow 0.15s;
}

.service-card:active {
  transform: scale(0.98);
}

/* 左侧道法分类色条 */
.card-color-bar {
  width: 8rpx;
  flex-shrink: 0;
  align-self: stretch;
}

.bar-chuan_gong { background: #e74c3c; }
.bar-mi_jing    { background: #3498db; }
.bar-zong_men   { background: #f39c12; }
.bar-xia_shan   { background: #27ae60; }
.bar-cang_jing  { background: #9b59b6; }
.bar-default    { background: var(--border); }

/* 左侧缩略图 */
.card-thumb {
  width: 180rpx;
  height: 180rpx;
  flex-shrink: 0;
  background: var(--surface-2);
}

.thumb-img {
  width: 100%;
  height: 100%;
  display: block;
}

/* 右侧信息区 */
.card-body {
  flex: 1;
  padding: 18rpx 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
  gap: 8rpx;
}

.service-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.4;
}

/* 标签行（最多2个） */
.tag-row {
  display: flex;
  gap: 10rpx;
}

.mini-tag {
  font-size: 20rpx;
  background: rgba(155, 89, 182, 0.08);
  color: var(--primary);
  padding: 2rpx 14rpx;
  border-radius: 12rpx;
  white-space: nowrap;
}

/* 服务者行 */
.provider-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.provider-avatar {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: var(--surface-2);
}

.provider-name {
  font-size: 22rpx;
  color: var(--text-secondary);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.provider-badge {
  font-size: 18rpx;
  padding: 2rpx 10rpx;
  background: rgba(155, 89, 182, 0.1);
  color: var(--primary);
  border-radius: 10rpx;
  white-space: nowrap;
}

/* 底部：价格 + 评分 */
.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.price-group {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.service-price {
  font-size: 30rpx;
  font-weight: 700;
  color: #e74c3c;
}

.price-yuan {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.price-unit {
  font-size: 20rpx;
  color: var(--text-secondary);
}

.rating-row {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.rating-star {
  font-size: 22rpx;
}

.rating-score {
  font-size: 24rpx;
  color: var(--text);
  font-weight: 600;
}

.rating-count {
  font-size: 20rpx;
  color: var(--text-secondary);
}

/* ===== 骨架屏（适配单列横向） ===== */
.loading-row {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.skeleton-card {
  display: flex;
  flex-direction: row;
  background: var(--surface);
  border-radius: 16rpx;
  overflow: hidden;
  height: 180rpx;
}

.skeleton-thumb {
  width: 180rpx;
  height: 180rpx;
  flex-shrink: 0;
}

.skeleton-body {
  flex: 1;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 14rpx;
}

.skeleton-line {
  height: 28rpx;
  border-radius: 8rpx;
  background: var(--border);
}

@keyframes skeleton-shimmer {
  0%   { opacity: 1; }
  50%  { opacity: 0.5; }
  100% { opacity: 1; }
}

.skeleton-pulse {
  animation: skeleton-shimmer 1.5s ease-in-out infinite;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
  gap: 16rpx;
}

.empty-img {
  width: 200rpx;
  height: 200rpx;
  opacity: 0.7;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
}

.empty-sub {
  font-size: 26rpx;
  color: var(--text-secondary);
  text-align: center;
}

.empty-btn {
  margin-top: 8rpx;
  padding: 16rpx 48rpx;
  background: var(--primary);
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
}

/* ===== 底部提示 ===== */
.bottom-tip {
  text-align: center;
  padding: 32rpx 0 16rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* ===== 发布悬浮按钮（纯色，无渐变） ===== */
.publish-fab {
  position: fixed;
  right: 40rpx;
  bottom: 140rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 56rpx;
  background: var(--primary);
  color: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 24rpx rgba(155, 89, 182, 0.35);
  opacity: 0;
  transform: scale(0) translateY(20rpx);
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  z-index: 100;
  pointer-events: none;
}

.fab-show {
  opacity: 1;
  transform: scale(1) translateY(0);
  pointer-events: auto;
}

.fab-icon {
  font-size: 52rpx;
  font-weight: 300;
  line-height: 1;
}

.fab-label {
  font-size: 18rpx;
  margin-top: 2rpx;
  letter-spacing: 1rpx;
}
