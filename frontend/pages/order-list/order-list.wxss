/* pages/order-list/order-list.wxss */
.page {
  min-height: 100vh;
  background: var(--bg);
  padding: 24rpx;
}

.tabs {
  display: flex;
  gap: 2rpx;
  background: var(--surface);
  border-radius: 16rpx;
  padding: 4rpx;
  margin-bottom: 24rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
  transition: all 0.2s;
}

.tab.active {
  background: var(--primary);
  color: #fff;
  font-weight: 600;
}

.order-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.order-card {
  cursor: pointer;
}

.order-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.order-id {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.order-status {
  font-size: 22rpx;
  background: transparent;
}

.order-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.order-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
  flex-wrap: wrap;
}

.meta-sessions, .meta-date {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.order-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1rpx solid var(--border);
  padding-top: 12rpx;
}

.order-price {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--accent);
}

.order-arrow {
  font-size: 40rpx;
  color: var(--text-secondary);
}
