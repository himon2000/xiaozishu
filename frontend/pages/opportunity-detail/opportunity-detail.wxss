/* pages/opportunity-detail/opportunity-detail.wxss */

.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #f8f4fc 0%, #f0e6f7 100%);
  padding-bottom: 160rpx;
}

/* 加载状态 */
.loading-state {
  text-align: center;
  padding: 200rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 资源信息 */
.opp-info {
  padding: 30rpx;
}

.opp-type {
  display: inline-block;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
}

.tag-internship { background: #e8f5e9; color: #2e7d32; }
.tag-referral { background: #fff3e0; color: #e65100; }
.tag-job { background: #e3f2fd; color: #1565c0; }
.tag-job_resource { background: #fce4ec; color: #c2185b; }

.opp-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  line-height: 1.4;
}

.opp-salary {
  margin-bottom: 24rpx;
}

.salary-tag {
  background: linear-gradient(135deg, #ff6b6b, #ee5a6f);
  color: #fff;
  padding: 10rpx 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: bold;
}

/* 公司卡片 */
.company-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.company-logo {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #9b59b6, #8e44ad);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.logo-placeholder {
  font-size: 36rpx;
  color: #fff;
  font-weight: bold;
}

.company-info {
  flex: 1;
}

.company-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 6rpx;
}

.company-detail {
  font-size: 24rpx;
  color: #999;
}

/* 基本信息 */
.info-section {
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
}

.info-row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
}

.info-row:not(:last-child) {
  border-bottom: 1rpx solid #f0e6f7;
}

.info-icon {
  font-size: 28rpx;
  margin-right: 16rpx;
}

.info-label {
  font-size: 26rpx;
  color: #999;
  width: 100rpx;
}

.info-value {
  flex: 1;
  font-size: 26rpx;
  color: #333;
}

.info-value.expired {
  color: #999;
}

/* 内容区块 */
.section {
  margin-bottom: 24rpx;
  padding: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.section-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  white-space: pre-wrap;
}

/* 标签 */
.tags-section {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 0 30rpx 24rpx;
}

.tag {
  background: #f3e5f5;
  color: #7d3c98;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

/* 发布者 */
.publisher-section {
  margin-bottom: 24rpx;
  padding: 24rpx;
}

.publisher-card {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.publisher-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.publisher-info {
  flex: 1;
}

.publisher-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.level-badge {
  font-size: 20rpx;
  background: #f3e5f5;
  color: #7d3c98;
  padding: 2rpx 10rpx;
  border-radius: 10rpx;
}

.publisher-school {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.cert-badge {
  font-size: 22rpx;
  color: #4caf50;
}

.view-profile {
  font-size: 26rpx;
  color: #9b59b6;
}

/* 认证要求 */
.requirement-section {
  margin-bottom: 24rpx;
  padding: 24rpx;
}

.requirement-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.requirement-item {
  font-size: 26rpx;
  color: #666;
}

/* 统计数据 */
.stats-section {
  display: flex;
  justify-content: center;
  gap: 60rpx;
  padding: 30rpx 0;
  margin-bottom: 24rpx;
}

.stat-item {
  text-align: center;
}

.stat-value {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #7d3c98;
}

.stat-label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

/* 申请列表 */
.applications-section {
  margin-top: 30rpx;
}

.application-card {
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.app-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.app-applicant {
  display: flex;
  align-items: center;
}

.app-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.app-info {
  flex: 1;
}

.app-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.app-school {
  font-size: 22rpx;
  color: #999;
}

.app-status {
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.status-pending { background: #fff3e0; color: #e65100; }
.status-accepted { background: #e8f5e9; color: #2e7d32; }
.status-rejected { background: #ffebee; color: #c62828; }

.app-message {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 16rpx;
  padding: 16rpx;
  background: #f8f4fc;
  border-radius: 12rpx;
}

.app-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
}

.action-btn.accept {
  background: #e8f5e9;
  color: #2e7d32;
}

.action-btn.reject {
  background: #ffebee;
  color: #c62828;
}

.app-result {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #666;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.left-actions {
  display: flex;
  gap: 30rpx;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.action-icon {
  font-size: 36rpx;
}

.action-icon.active {
  color: #e91e63;
}

.action-text {
  font-size: 22rpx;
  color: #666;
  margin-top: 4rpx;
}

.right-actions {
  display: flex;
  gap: 16rpx;
}

.contact-btn, .external-btn {
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 24rpx;
  background: #f3e5f5;
  color: #7d3c98;
  border-radius: 36rpx;
  font-size: 26rpx;
}

.contact-btn::after, .external-btn::after {
  border: none;
}

.apply-btn {
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 36rpx;
  background: linear-gradient(135deg, #9b59b6, #8e44ad);
  color: #fff;
  border-radius: 36rpx;
  font-size: 28rpx;
}

.apply-btn::after {
  border: none;
}

.applied-btn {
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 24rpx;
  background: #e0e0e0;
  color: #666;
  border-radius: 36rpx;
  font-size: 26rpx;
}

.applied-btn::after {
  border: none;
}

.delete-btn {
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 24rpx;
  background: #ffebee;
  color: #c62828;
  border-radius: 36rpx;
  font-size: 26rpx;
}

.delete-btn::after {
  border: none;
}

/* 申请弹窗 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 90%;
  max-height: 80vh;
  background: #fff;
  border-radius: 30rpx;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0e6f7;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: 40rpx;
  color: #999;
  padding: 10rpx;
}

.modal-body {
  flex: 1;
  overflow-y: auto;
  padding: 20rpx 30rpx;
}

.apply-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.apply-company {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 24rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  height: 72rpx;
  background: #f8f4fc;
  border-radius: 20rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  min-height: 200rpx;
  background: #f8f4fc;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 30rpx;
  border-top: 1rpx solid #f0e6f7;
}

.cancel-btn, .confirm-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rrpx;
}

.cancel-btn {
  background: #f5f5f5;
  color: #666;
}

.confirm-btn {
  background: linear-gradient(135deg, #9b59b6, #8e44ad);
  color: #fff;
}

.cancel-btn::after, .confirm-btn::after {
  border: none;
}
