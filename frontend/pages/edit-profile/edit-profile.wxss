/* pages/edit-profile/edit-profile.wxss - 编辑个人资料 */

/* 页面背景 */
.page {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 0 0 40rpx 0;
}

/* 加载状态 */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 400rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #e0e0e0;
  border-top-color: #07c160;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #999;
}

/* 分组标题 */
.group-label {
  padding: 28rpx 32rpx 12rpx;
  font-size: 24rpx;
  color: #999;
}

/* 菜单组 */
.menu-group {
  margin: 0 24rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

/* 菜单项 */
.menu-item {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #f0f0f0;
  min-height: 96rpx;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-title {
  font-size: 30rpx;
  color: #333;
  flex-shrink: 0;
  width: 140rpx;
}

.menu-value {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #333;
}

.menu-value.placeholder {
  color: #bbb;
}

.menu-arrow {
  margin-left: 12rpx;
  font-size: 32rpx;
  color: #ccc;
}

/* 头像行 */
.avatar-row {
  padding: 20rpx 28rpx;
}

.avatar-row .menu-title {
  width: 140rpx;
}

.avatar-preview {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-left: auto;
}

/* 输入框 */
.input-right {
  flex: 1;
  display: flex;
  justify-content: flex-end;
}

.menu-input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #333;
}

/* 个人简介 */
.bio-item {
  flex-direction: column;
  align-items: flex-start;
}

.bio-item .menu-title {
  margin-bottom: 16rpx;
  width: auto;
}

.bio-textarea {
  width: 100%;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  min-height: 120rpx;
  padding: 16rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.bio-counter {
  align-self: flex-end;
  font-size: 22rpx;
  color: #bbb;
  margin-top: 8rpx;
}

/* 保存按钮 */
.save-btn-area {
  padding: 48rpx 40rpx 0;
}

.save-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #07c160;
  color: #fff;
  font-size: 32rpx;
  border-radius: 16rpx;
  border: none;
  text-align: center;
}

.save-btn::after {
  border: none;
}

.save-btn.disabled {
  opacity: 0.6;
}

/* 底部安全区 */
.safe-area-bottom {
  height: env(safe-area-inset-bottom);
}
