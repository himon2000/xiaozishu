/* pages/team-detail/team-detail.wxss */
.page {
  min-height: 100vh;
  background: var(--bg);
  padding: 24rpx;
}

.loading-state {
  text-align: center;
  padding: 100rpx;
  color: var(--text-secondary);
}

/* 组队信息卡片 */
.team-info {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.team-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.team-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text);
  flex: 1;
  margin-right: 16rpx;
  line-height: 1.4;
}

.team-status {
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  white-space: nowrap;
}

.tag-recruiting {
  background: #fff3e0;
  color: #ff9800;
}

.tag-full {
  background: #e8f5e9;
  color: #4caf50;
}

.tag-in_progress {
  background: #e3f2fd;
  color: #2196f3;
}

.tag-closed, .tag-completed {
  background: var(--surface-2);
  color: var(--text-secondary);
}

.category-badge {
  display: inline-block;
  background: var(--primary);
  color: #fff;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  margin-bottom: 16rpx;
}

.team-desc {
  margin-bottom: 16rpx;
}

.desc-label {
  display: block;
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 8rpx;
}

.desc-content {
  display: block;
  font-size: 28rpx;
  color: var(--text);
  line-height: 1.6;
}

.team-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.mini-tag {
  font-size: 22rpx;
  background: var(--surface-2);
  color: var(--text-secondary);
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
}

.team-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border);
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.meta-icon {
  font-size: 28rpx;
}

.meta-text {
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* 分组标题 */
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  margin: 24rpx 0 16rpx;
}

/* 组长卡片 */
.leader-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.leader-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.leader-info {
  flex: 1;
}

.leader-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 4rpx;
}

.level-badge {
  font-size: 22rpx;
  margin-left: 8rpx;
}

.leader-school {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.view-profile {
  font-size: 26rpx;
  color: var(--primary);
}

/* 成员列表 */
.member-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 120rpx;
}

.member-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
}

.member-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
}

.member-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
}

.member-info {
  flex: 1;
}

.member-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text);
  margin-bottom: 2rpx;
}

.role-badge {
  margin-left: 8rpx;
}

.member-school {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.member-level {
  font-size: 22rpx;
  color: var(--text-secondary);
}

/* 操作按钮 */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx;
  background: var(--bg);
  border-top: 1rpx solid var(--border);
  display: flex;
  gap: 16rpx;
}

.action-btn {
  flex: 1;
  padding: 24rpx;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}

.action-btn.primary {
  background: var(--primary);
  color: #fff;
}

.action-btn.danger {
  background: var(--surface);
  color: #e74c3c;
  border: 1rpx solid #e74c3c;
}
