<!-- pages/my-research/my-research.wxml - 我的课题页面 -->
<view class="page">

  <!-- 顶部统计卡片 -->
  <view class="header-bg">
    <view class="stats-card">
      <view class="stat-item">
        <text class="stat-num">{{stats.total}}</text>
        <text class="stat-label">全部课题</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-num">{{stats.ongoing}}</text>
        <text class="stat-label">进行中</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-num">{{stats.published}}</text>
        <text class="stat-label">已发表</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-num">{{stats.cited}}</text>
        <text class="stat-label">被引用</text>
      </view>
    </view>
  </view>

  <!-- 标签页切换 -->
  <view class="tab-bar">
    <view class="tab-item {{currentTab === 'ongoing' ? 'active' : ''}}" bindtap="onTabChange" data-tab="ongoing">
      <text>进行中</text>
      <text class="tab-count" wx:if="{{stats.ongoing > 0}}">{{stats.ongoing}}</text>
    </view>
    <view class="tab-item {{currentTab === 'published' ? 'active' : ''}}" bindtap="onTabChange" data-tab="published">
      <text>已发表</text>
      <text class="tab-count" wx:if="{{stats.published > 0}}">{{stats.published}}</text>
    </view>
    <view class="tab-item {{currentTab === 'all' ? 'active' : ''}}" bindtap="onTabChange" data-tab="all">
      <text>全部</text>
    </view>
  </view>

  <!-- 课题列表 -->
  <view class="content">
    <block wx:if="{{researchList.length > 0}}">
      <view class="research-list">
        <view class="research-item" wx:for="{{researchList}}" wx:key="id"
              wx:if="{{currentTab === 'all' || item.status === currentTab}}"
              bindtap="onResearchTap" data-id="{{item.id}}">

          <!-- 课题头部 -->
          <view class="research-header">
            <view class="status-tag {{item.status}}">
              <text>{{item.statusText}}</text>
            </view>
            <text class="research-title">{{item.title}}</text>
          </view>

          <!-- 进行中课题显示进度 -->
          <view class="research-progress" wx:if="{{item.status === 'ongoing'}}">
            <view class="progress-bar">
              <view class="progress-fill" style="width: {{item.progress}}%"></view>
            </view>
            <text class="progress-text">{{item.progress}}%</text>
          </view>

          <!-- 已发表课题显示期刊 -->
          <view class="research-journal" wx:if="{{item.status === 'published'}}">
            <text class="journal-name">📖 {{item.journal}}</text>
            <text class="publish-date">{{item.publishDate}}</text>
          </view>

          <!-- 底部信息 -->
          <view class="research-footer">
            <view class="author-info">
              <image class="author-avatar" src="{{item.author.avatar || '/assets/default-avatar.png'}}" mode="aspectFill" />
              <text class="author-name">{{item.author.name}}</text>
            </view>

            <view class="research-stats">
              <view class="research-stat" wx:if="{{item.members}}">
                <text>👥 {{item.members}}</text>
              </view>
              <view class="research-stat" wx:if="{{item.citations}}">
                <text>📚 {{item.citations}}引用</text>
              </view>
              <view class="research-stat" wx:if="{{item.views}}">
                <text>👁️ {{item.views}}</text>
              </view>
              <view class="research-stat" wx:if="{{item.comments}}">
                <text>💬 {{item.comments}}</text>
              </view>
            </view>
          </view>

          <text class="research-arrow">›</text>
        </view>
      </view>
    </block>

    <!-- 空状态 -->
    <block wx:else>
      <view class="empty-state">
        <text class="empty-icon">🔬</text>
        <text class="empty-text">{{emptyTips[currentTab] || '暂无课题'}}</text>
        <view class="empty-btn" bindtap="onPublishResearch">
          <text>发布课题</text>
        </view>
      </view>
    </block>
  </view>

  <!-- 发布按钮 -->
  <view class="publish-fab" bindtap="onPublishResearch">
    <text>+</text>
  </view>

  <view class="safe-area-bottom"></view>
</view>
