/* pages/my-research/my-research.wxss - 我的课题页面样式 */

.page {
  min-height: 100vh;
  background: #f5f5f5;
}

/* 顶部背景 */
.header-bg {
  background: linear-gradient(135deg, #9b59b6, #8e44ad);
  padding: 30rpx 30rpx 50rpx;
}

/* 统计卡片 */
.stats-card {
  display: flex;
  justify-content: space-around;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  padding: 30rpx 20rpx;
  box-shadow: 0 8rpx 30rpx rgba(155, 89, 182, 0.2);
}

.stat-item {
  text-align: center;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #9b59b6;
  display: block;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
  display: block;
}

.stat-divider {
  width: 2rpx;
  background: #f0f0f0;
}

/* 标签栏 */
.tab-bar {
  display: flex;
  background: #fff;
  margin-top: -20rpx;
  margin-left: 30rpx;
  margin-right: 30rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.tab-item.active {
  color: #9b59b6;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background: #9b59b6;
  border-radius: 2rpx;
}

.tab-count {
  background: #f0f0f0;
  color: #666;
  padding: 2rpx 10rpx;
  border-radius: 10rpx;
  font-size: 20rpx;
}

.tab-item.active .tab-count {
  background: rgba(155, 89, 182, 0.1);
  color: #9b59b6;
}

/* 内容区域 */
.content {
  padding: 30rpx;
}

/* 课题列表 */
.research-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.research-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  position: relative;
}

.research-header {
  margin-bottom: 16rpx;
}

.status-tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.status-tag.ongoing {
  background: rgba(255, 159, 67, 0.1);
  color: #ff9f43;
}

.status-tag.published {
  background: rgba(46, 213, 115, 0.1);
  color: #2ed573;
}

.research-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.5;
  display: block;
}

/* 进度条 */
.research-progress {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.progress-bar {
  flex: 1;
  height: 8rpx;
  background: #e9d5ff;
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #a855f7, #8b5cf6);
  border-radius: 4rpx;
}

.progress-text {
  font-size: 24rpx;
  color: #9b59b6;
  font-weight: 600;
}

/* 期刊信息 */
.research-journal {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.journal-name {
  font-size: 26rpx;
  color: #666;
}

.publish-date {
  font-size: 22rpx;
  color: #999;
}

/* 底部信息 */
.research-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.author-info {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.author-avatar {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
}

.author-name {
  font-size: 24rpx;
  color: #666;
}

.research-stats {
  display: flex;
  gap: 16rpx;
}

.research-stat {
  font-size: 22rpx;
  color: #999;
}

.research-arrow {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 36rpx;
  color: #ccc;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 30rpx;
}

.empty-btn {
  background: linear-gradient(135deg, #a855f7, #8b5cf6);
  color: #fff;
  padding: 20rpx 60rpx;
  border-radius: 30rpx;
  font-size: 28rpx;
  font-weight: 600;
}

/* 发布按钮 */
.publish-fab {
  position: fixed;
  right: 30rpx;
  bottom: 100rpx;
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #a855f7, #8b5cf6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 30rpx rgba(155, 89, 182, 0.4);
}

.publish-fab text {
  font-size: 60rpx;
  color: #fff;
  line-height: 1;
}

.safe-area-bottom {
  height: constant(safe-area-inset-bottom);
  height: env(safe-area-inset-bottom);
  padding-bottom: 200rpx;
}
