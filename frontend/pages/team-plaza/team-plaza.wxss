/* pages/team-plaza/team-plaza.wxss */
.page {
  min-height: 100vh;
  background: var(--bg);
  padding: 24rpx;
}

/* 页面头部 */
.page-header {
  text-align: center;
  padding: 10rpx 0 20rpx;
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--primary);
}

.page-subtitle {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

/* 历练分类提示 */
.liilian-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx;
  margin-bottom: 20rpx;
  background: #fff3e0;
  border-radius: 16rpx;
  font-size: 24rpx;
  color: #e65100;
}

.liilian-tip .link {
  color: var(--primary);
  font-weight: bold;
}

.category-item.is-liilian {
  opacity: 0.7;
}

.category-item.is-liilian.active {
  opacity: 1;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.search-input {
  flex: 1;
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 40rpx;
  padding: 16rpx 28rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  overflow: hidden;
  height: 72rpx;
  line-height: 72rpx;
  color: var(--text);
  font-size: 28rpx;
}

.search-btn {
  background: var(--primary);
  color: #fff;
  border-radius: 40rpx;
  padding: 0 28rpx;
  border: none;
  font-size: 28rpx;
}

/* 分类切换 —— 2×2 网格 */
.category-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.category-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  /* 2 列等宽：(100% - 1 个 gap) / 2 */
  width: calc(50% - 8rpx);
  padding: 20rpx 24rpx;
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  box-sizing: border-box;
  transition: all 0.2s;
}

.category-item.active {
  background: var(--primary);
  border-color: var(--primary);
}

.cat-icon {
  font-size: 36rpx;
  flex-shrink: 0;
}

.cat-name {
  font-size: 26rpx;
  color: var(--text-secondary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.category-item.active .cat-name {
  color: #fff;
}

.cat-sub {
  font-size: 20rpx;
  color: var(--text-secondary);
  opacity: 0.7;
  margin-top: 2rpx;
}

.text-hint {
  font-size: 24rpx;
  color: var(--text-secondary);
  opacity: 0.7;
  margin-top: 8rpx;
}

/* 操作栏 */
.action-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.result-count {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.create-btn {
  background: var(--primary);
  color: #fff;
  border-radius: 30rpx;
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  border: none;
}

/* 组队列表 */
.team-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.team-card {
  padding: 24rpx;
}

.team-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.team-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  flex: 1;
  margin-right: 16rpx;
}

.team-status {
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 20rpx;
  white-space: nowrap;
}

.tag-recruiting {
  background: #fff3e0;
  color: #ff9800;
}

.tag-full {
  background: #e8f5e9;
  color: #4caf50;
}

.tag-in_progress {
  background: #e3f2fd;
  color: #2196f3;
}

.tag-closed, .tag-completed {
  background: var(--surface-2);
  color: var(--text-secondary);
}

.team-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.team-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.mini-tag {
  font-size: 20rpx;
  background: var(--surface-2);
  color: var(--text-secondary);
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.team-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--border);
}

.member-info {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.member-count {
  font-size: 24rpx;
  color: var(--primary);
  font-weight: 500;
}

.deadline {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.creator-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.creator-avatar {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
}

.creator-name {
  font-size: 22rpx;
  color: var(--text-secondary);
  max-width: 120rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.creator-level {
  font-size: 18rpx;
  color: var(--text-hint);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
}

.empty-state .icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-state text {
  font-size: 28rpx;
  color: var(--text);
  margin-bottom: 8rpx;
}

.create-btn-lg {
  margin-top: 32rpx;
  background: var(--primary);
  color: #fff;
  border-radius: 40rpx;
  padding: 20rpx 60rpx;
  font-size: 28rpx;
  border: none;
}

/* 加载状态 */
.loading-container {
  text-align: center;
  padding: 32rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* 弹窗 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: relative;
  width: 100%;
  max-height: 90vh;
  background: var(--surface);
  border-radius: 32rpx 32rpx 0 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.modal-header {
  flex-shrink: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid var(--border);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
}

.modal-close {
  font-size: 36rpx;
  color: var(--text-secondary);
  padding: 8rpx;
}

.modal-body {
  flex: 1;
  padding: 24rpx 32rpx;
  overflow-y: auto;
  min-height: 0;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  background: var(--bg);
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  padding: 0 24rpx;
  color: var(--text);
  font-size: 28rpx;
  line-height: 88rpx;
  box-sizing: border-box;
  overflow: hidden;
  line-height: normal;
}

.form-textarea {
  width: 100%;
  min-height: 240rpx;
  height: 240rpx;
  background: var(--bg);
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  color: var(--text);
  font-size: 28rpx;
  line-height: 1.6;
  box-sizing: border-box;
  resize: none;
  box-sizing: border-box;
  resize: none;
}

.form-picker.placeholder {
  color: var(--text-hint);
}

.form-picker {
  background: var(--bg);
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  color: var(--text);
  font-size: 28rpx;
  box-sizing: border-box;
}

.tag-input-wrap {
  display: flex;
  gap: 12rpx;
}

.tag-input {
  flex: 1;
}

.add-tag-btn {
  background: var(--primary);
  color: #fff;
  border-radius: 16rpx;
  border: none;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.tag-item {
  background: var(--primary);
  color: #fff;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.tag-remove {
  margin-left: 8rpx;
  font-size: 28rpx;
}

.modal-footer {
  flex-shrink: 0;
  display: flex;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  border-top: 1rpx solid var(--border);
}

.cancel-btn {
  flex: 1;
  background: var(--bg);
  color: var(--text);
  border: 1rpx solid var(--border);
  border-radius: 40rpx;
  padding: 20rpx;
  font-size: 28rpx;
}

.confirm-btn {
  flex: 2;
  background: var(--primary);
  color: #fff;
  border-radius: 40rpx;
  padding: 20rpx;
  font-size: 28rpx;
  border: none;
}
