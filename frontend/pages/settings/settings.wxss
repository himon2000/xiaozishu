/* pages/settings/settings.wxss - 我的设置 */

.page {
  min-height: 100vh;
  background: #f5f0fa;
  padding-bottom: 140rpx;
}

/* 分组标签 */
.group-label {
  font-size: 24rpx;
  color: #9b59b6;
  font-weight: 600;
  padding: 28rpx 32rpx 10rpx;
  letter-spacing: 1rpx;
}

/* 菜单分组 */
.menu-group {
  background: #fff;
  margin: 0 24rpx 8rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(155, 89, 182, 0.07);
}

/* 菜单项 */
.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 28rpx;
  border-bottom: 1rpx solid #f5f0fa;
  position: relative;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 36rpx;
  width: 56rpx;
  flex-shrink: 0;
  text-align: center;
}

.menu-title {
  flex: 1;
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  margin-left: 8rpx;
}

.menu-desc {
  font-size: 24rpx;
  color: #bbb;
  margin-right: 10rpx;
}

.menu-arrow {
  font-size: 32rpx;
  color: #ccc;
}

/* Switch 样式 */
.menu-item switch {
  transform: scale(0.8);
}

/* 安全区 */
.safe-area-bottom {
  height: 120rpx;
}
