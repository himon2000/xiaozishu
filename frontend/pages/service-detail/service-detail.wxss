/* pages/service-detail/service-detail.wxss */
.page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 160rpx;
}

.cover {
  width: 100%;
  height: 400rpx;
  background: var(--surface);
}

.section {
  margin: 24rpx;
}

.section-title-sm {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
}

.service-title {
  margin-bottom: 12rpx;
}

.service-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.mini-tag {
  font-size: 22rpx;
  background: var(--surface-2);
  color: var(--text-secondary);
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
}

/* 大虾卡片 */
.provider-card {
  display: flex;
  gap: 24rpx;
  align-items: flex-start;
}

.provider-avatar-lg {
  width: 120rpx; height: 120rpx;
  border-radius: 50%;
  border: 2rpx solid var(--border);
  flex-shrink: 0;
}

.provider-info {
  flex: 1;
  min-width: 0;
}

.provider-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
  flex-wrap: wrap;
}

.provider-school {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 6rpx;
}

/* 信任认证标签 */
.trust-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin: 12rpx 0;
}

.trust-badge {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  background: var(--surface-2);
  color: var(--text-secondary);
}

.trust-badge.badge-verified {
  background: linear-gradient(135deg, #e8f5e9 0%, #c8e6c9 100%);
  color: #2e7d32;
}

.trust-badge.badge-gold {
  background: linear-gradient(135deg, #fff8e1 0%, #ffecb3 100%);
  color: #f57c00;
}

.trust-badge.badge-fast {
  background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);
  color: #1565c0;
}

.trust-badge.badge-disabled {
  opacity: 0.5;
}

.badge-icon {
  font-size: 18rpx;
}

.badge-text {
  font-weight: 600;
}

.badge-sub {
  font-size: 18rpx;
  opacity: 0.7;
  margin-left: 2rpx;
}

/* 服务者统计 */
.provider-stats {
  display: flex;
  align-items: center;
  background: var(--surface-2);
  border-radius: 16rpx;
  padding: 12rpx 16rpx;
  margin: 12rpx 0;
  gap: 8rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stat-val {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text);
}

.stat-label {
  font-size: 18rpx;
  color: var(--text-secondary);
}

.stat-divider {
  width: 1rpx;
  height: 40rpx;
  background: var(--border);
}

/* 师傅主页入口 */
.mentor-actions {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border);
}

.btn-small {
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
}

/* FAQ */
.faq-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.faq-item:last-child {
  border-bottom: none;
}

.faq-q {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 8rpx;
}

.faq-a {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

/* 服务保障 */
.guarantee-card {
  background: linear-gradient(135deg, #f3e5f5 0%, #e1bee7 100%);
}

.guarantee-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.guarantee-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  color: var(--text);
}

.guarantee-icon {
  font-size: 28rpx;
}

.guarantee-text {
  flex: 1;
}

.provider-specialties {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 8rpx;
}

.description {
  font-size: 28rpx;
  color: var(--text);
  line-height: 1.8;
  white-space: pre-wrap;
}

.delivery-row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  font-size: 26rpx;
  flex-wrap: wrap;
}

.label {
  color: var(--text-secondary);
}

/* 定价 */
.pricing {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.price-main {
  font-size: 56rpx;
  font-weight: 800;
  color: var(--accent);
}

.price-unit {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.pricing-note {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

/* 课次 */
.sessions-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sessions-ctrl {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: var(--surface-2);
  border-radius: 40rpx;
  padding: 8rpx 8rpx;
}

.ctrl-btn {
  width: 60rpx; height: 60rpx;
  border-radius: 50%;
  background: var(--primary);
  color: #fff;
  font-size: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
}

.sessions-num {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text);
  min-width: 60rpx;
  text-align: center;
}

.sessions-hint {
  font-size: 22rpx;
  color: var(--text-secondary);
}

/* 底部栏 */
.bottom-bar {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  background: var(--surface);
  border-top: 1rpx solid var(--border);
  padding: 20rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  z-index: 100;
}

.bottom-info {
  display: flex;
  flex-direction: column;
}

.bottom-label {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.bottom-price {
  font-size: 44rpx;
  font-weight: 800;
  color: var(--accent);
}

/* 评价模块 */
.section-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.view-all-btn {
  font-size: 26rpx;
  color: var(--primary);
}

.rating-overview {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 16rpx 0;
}

.rating-score {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.score-num {
  font-size: 56rpx;
  font-weight: bold;
  color: #ff9800;
}

.score-label {
  font-size: 28rpx;
  color: #ff9800;
}

.rating-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.stars-row {
  display: flex;
}

.star-icon {
  font-size: 28rpx;
  color: #ddd;
  margin-right: 4rpx;
}

.star-icon.active {
  color: #ff9800;
}

.review-count {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.no-review {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.review-tags-preview {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border);
  margin-top: 16rpx;
}

.review-tag {
  padding: 6rpx 16rpx;
  background: #fff3e0;
  color: #ff9800;
  border-radius: 20rpx;
  font-size: 24rpx;
}
