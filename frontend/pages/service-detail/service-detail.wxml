<!-- pages/service-detail/service-detail.wxml -->
<view class="page" wx:if="{{!loading && service}}">
  <!-- 封面 -->
  <image class="cover" src="{{service.cover_image || '/assets/default-service.png'}}" mode="aspectFill" />

  <!-- 服务信息 -->
  <view class="section card">
    <view class="tag-dao-{{service.dao_fa_type}} tag" style="margin-bottom: 16rpx;">
      {{service.dao_fa_type}}
    </view>
    <view class="service-title title-lg">{{service.title}}</view>
    <view class="service-tags">
      <text wx:for="{{service.tags}}" wx:key="item" class="mini-tag">{{item}}</text>
    </view>
  </view>

  <!-- 服务者信息 -->
  <view class="section card" wx:if="{{provider}}">
    <view class="section-title-sm">🍠 服务者</view>
    <view class="provider-card">
      <image class="provider-avatar-lg" src="{{provider.avatar_url || '/assets/default-avatar.png'}}" />
      <view class="provider-info">
        <view class="provider-name-row">
          <text class="title-md">{{provider.nickname}}</text>
          <view class="tag tag-level-{{provider.level}}" style="margin-left: 8rpx">
            {{provider.level_icon}} {{provider.level_name}}
          </view>
        </view>
        <view class="provider-school">{{provider.school}} · {{provider.major}}</view>

        <!-- 信任认证标签 -->
        <view class="trust-badges">
          <view class="trust-badge badge-verified" wx:if="{{provider.real_cert}}">
            <text class="badge-icon">✓</text>
            <text class="badge-text">灵根</text>
            <text class="badge-sub">(实名)</text>
          </view>
          <view class="trust-badge badge-verified" wx:if="{{provider.school}}">
            <text class="badge-icon">🎓</text>
            <text class="badge-text">宗门</text>
            <text class="badge-sub">(校园)</text>
          </view>
          <view class="trust-badge badge-gold" wx:if="{{provider.rating >= 4.8}}">
            <text class="badge-icon">🏆</text>
            <text class="badge-text">金丹</text>
            <text class="badge-sub">(金牌)</text>
          </view>
          <view class="trust-badge badge-fast" wx:if="{{provider.reply_rate >= 90}}">
            <text class="badge-icon">⚡</text>
            <text class="badge-text">秒回</text>
            <text class="badge-sub">(极速)</text>
          </view>
        </view>

        <!-- 服务者统计 -->
        <view class="provider-stats">
          <view class="stat-item">
            <text class="stat-val">⭐ {{provider.rating}}</text>
            <text class="stat-label">评分</text>
          </view>
          <view class="stat-divider"></view>
          <view class="stat-item">
            <text class="stat-val">{{provider.rating_count || 0}}</text>
            <text class="stat-label">服务</text>
          </view>
        </view>
      </view>
    </view>

    <view class="mentor-actions">
      <button class="btn btn-small btn-ghost" bindtap="onViewMentorProfile">
        查看达人主页 →
      </button>
    </view>
  </view>

  <!-- 服务描述 -->
  <view class="section card">
    <view class="section-title-sm">📜 服务说明</view>
    <view class="description">{{service.description || '暂无详细说明'}}</view>
    <view class="text-muted" bindtap="onReport" style="margin-top: 24rpx; text-align: right;">举报此服务</view>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar safe-area-bottom" wx:if="{{features.payment}}">
    <view class="bottom-info">
      <text class="bottom-label">合计</text>
      <text class="bottom-price">💎{{service.price}} 灵石</text>
    </view>
    <button class="btn btn-primary" bindtap="onBook" style="width: 300rpx;">
      🐲 立即预约
    </button>
  </view>
</view>

<!-- 加载中 -->
<view class="loading-container" wx:if="{{loading}}">
  <text>加载中...</text>
</view>
