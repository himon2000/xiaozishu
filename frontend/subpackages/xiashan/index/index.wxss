/* 下山历练 - 首页样式 */
.page {
  min-height: 100vh;
  background: var(--bg);
  padding: 24rpx 24rpx 40rpx;
}

.banner {
  background: linear-gradient(135deg, #9b59b6, #8e44ad);
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  color: #fff;
}

.banner-title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.banner-sub {
  font-size: 26rpx;
  opacity: 0.9;
}

.section {
  background: var(--surface);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
}

.section-more {
  font-size: 26rpx;
  color: #9b59b6;
}

.type-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.type-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 12rpx;
  background: var(--bg);
  border-radius: 16rpx;
}

.type-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.type-name {
  font-size: 24rpx;
  color: var(--text);
}

.opportunity-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.opportunity-card {
  background: var(--bg);
  border-radius: 16rpx;
  padding: 20rpx;
}

.opp-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 8rpx;
}

.opp-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  flex: 1;
}

.opp-salary {
  font-size: 28rpx;
  font-weight: 700;
  color: #9b59b6;
  white-space: nowrap;
  margin-left: 16rpx;
}

.opp-company {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.opp-tags {
  display: flex;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.tag {
  font-size: 20rpx;
  background: rgba(155, 89, 182, 0.1);
  color: #9b59b6;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
}

.opp-footer {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: var(--text-secondary);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
  gap: 8rpx;
}

.empty-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
}

.empty-sub {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 发布悬浮按钮 */
.publish-fab {
  position: fixed;
  right: 32rpx;
  bottom: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #9b59b6, #8e44ad);
  border-radius: 50%;
  box-shadow: 0 8rpx 24rpx rgba(155, 89, 182, 0.4);
  z-index: 100;
}

.fab-icon {
  font-size: 40rpx;
  margin-bottom: 2rpx;
}

.fab-label {
  font-size: 18rpx;
  color: #fff;
  font-weight: 500;
}
