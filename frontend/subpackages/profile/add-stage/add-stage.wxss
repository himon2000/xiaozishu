/* 添加人生阶段页面样式 - 紫色主题 */
page {
  background: #f5f0fa;
}

.page {
  min-height: 100vh;
  background: #f5f0fa;
  padding: 24rpx;
  padding-bottom: 120rpx;
}

.page-header {
  text-align: center;
  padding: 32rpx 0;
}

.page-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 8rpx;
}

.page-desc {
  font-size: 26rpx;
  color: #999;
}

/* 区块 */
.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(155, 89, 182, 0.08);
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

/* 阶段类型选择 */
.type-grid {
  display: flex;
  gap: 16rpx;
}

.type-card {
  flex: 1;
  background: #faf7ff;
  border: 2rpx solid #e9d5ff;
  border-radius: 16rpx;
  padding: 24rpx 16rpx;
  text-align: center;
  transition: all 0.2s;
}

.type-card-active {
  background: linear-gradient(135deg, #f3e8ff, #e9d5ff);
  border-color: #9b59b6;
}

.type-icon {
  display: block;
  font-size: 56rpx;
  margin-bottom: 8rpx;
}

.type-name {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 4rpx;
}

.type-desc {
  display: block;
  font-size: 22rpx;
  color: #999;
}

/* 角色选择 */
.role-grid {
  display: flex;
  gap: 16rpx;
}

.role-card {
  flex: 1;
  background: #faf7ff;
  border: 2rpx solid #e9d5ff;
  border-radius: 16rpx;
  padding: 24rpx 16rpx;
  text-align: center;
  transition: all 0.2s;
}

.role-card-active {
  background: linear-gradient(135deg, #f3e8ff, #e9d5ff);
  border-color: #9b59b6;
}

.role-icon {
  display: block;
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.role-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 4rpx;
}

.role-desc {
  display: block;
  font-size: 22rpx;
  color: #999;
}

/* 输入框 */
.input {
  background: #faf7ff;
  border: 1rpx solid #e9d5ff;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #333;
  height: 88rpx;
  line-height: 88rpx;
  box-sizing: border-box;
}

/* Picker */
.grade-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #faf7ff;
  border: 1rpx solid #e9d5ff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-top: 16rpx;
}

.grade-label {
  font-size: 28rpx;
  color: #333;
}

.picker-value {
  font-size: 28rpx;
  color: #9b59b6;
}

.picker-arrow {
  margin-left: 8rpx;
  color: #999;
}

/* 提交按钮 */
.submit-section {
  margin-top: 32rpx;
}

.btn {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.btn-primary {
  background: linear-gradient(135deg, #a855f7, #8b5cf6);
  color: #fff;
  border: none;
}

.btn-block {
  width: 100%;
}
