/* 万宗宝鉴 - 首页样式 */
.page {
  min-height: 100vh;
  background: var(--bg);
  padding: 24rpx 24rpx 40rpx;
}

.banner {
  background: linear-gradient(135deg, #9b59b6, #8e44ad);
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  color: #fff;
}

.banner-title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.banner-sub {
  font-size: 26rpx;
  opacity: 0.9;
}

.section {
  background: var(--surface);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.section-header {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
}

.section-more {
  font-size: 26rpx;
  color: var(--primary);
}

.tier-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.tier-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 12rpx;
  background: var(--bg);
  border-radius: 16rpx;
}

.tier-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.tier-name {
  font-size: 24rpx;
  color: var(--text);
}

.service-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.service-card {
  background: var(--bg);
  border-radius: 16rpx;
  overflow: hidden;
}

.card-cover {
  width: 100%;
  height: 160rpx;
  background: var(--border);
}

.card-body {
  padding: 16rpx;
}

.service-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.service-provider {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.provider-avatar {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: var(--border);
}

.provider-name {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.service-price {
  font-size: 28rpx;
  font-weight: 700;
  color: #9b59b6;
}

.service-rating {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
}

.empty-title {
  font-size: 28rpx;
  color: var(--text-secondary);
}

/* 发布悬浮按钮 */
.publish-fab {
  position: fixed;
  right: 32rpx;
  bottom: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #9b59b6, #8e44ad);
  border-radius: 50%;
  box-shadow: 0 8rpx 24rpx rgba(155, 89, 182, 0.4);
  z-index: 100;
}

.fab-icon {
  font-size: 40rpx;
  margin-bottom: 2rpx;
}

.fab-label {
  font-size: 18rpx;
  color: #fff;
  font-weight: 500;
}
