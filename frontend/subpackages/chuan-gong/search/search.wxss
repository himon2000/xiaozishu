/* 传功授法 - 搜索页样式 */
.page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: env(safe-area-inset-bottom);
}

/* ===== 搜索栏 ===== */
.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: var(--surface);
  position: sticky;
  top: 0;
  z-index: 10;
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: var(--bg);
  border: 1.5rpx solid var(--border);
  border-radius: 48rpx;
  padding: 14rpx 24rpx;
  gap: 12rpx;
}

.search-icon {
  font-size: 28rpx;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  background: transparent;
}

.clear-btn {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.filter-btn {
  padding: 14rpx 24rpx;
  background: var(--bg);
  border: 1.5rpx solid var(--border);
  border-radius: 48rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.filter-btn.active {
  background: #9b59b6;
  border-color: #9b59b6;
  color: #fff;
}

/* ===== Tab 切换 ===== */
.tab-bar {
  display: flex;
  background: var(--surface);
  border-bottom: 1rpx solid var(--border);
}

.tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 24rpx 0;
  font-size: 30rpx;
  color: var(--text-secondary);
  position: relative;
}

.tab.active {
  color: #9b59b6;
  font-weight: 600;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background: #9b59b6;
  border-radius: 3rpx;
}

.tab-count {
  font-size: 24rpx;
  background: rgba(231, 76, 60, 0.1);
  color: #9b59b6;
  padding: 2rpx 10rpx;
  border-radius: 12rpx;
}

/* ===== 筛选面板 ===== */
.filter-panel {
  background: var(--surface);
  padding: 24rpx;
  border-bottom: 1rpx solid var(--border);
}

.filter-section {
  margin-bottom: 24rpx;
}

.filter-title {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 14rpx;
  font-weight: 500;
}

.filter-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.filter-chip {
  padding: 10rpx 22rpx;
  background: var(--bg);
  border: 1.5rpx solid var(--border);
  border-radius: 24rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.filter-chip.active {
  background: #9b59b6;
  border-color: #9b59b6;
  color: #fff;
}

.filter-actions {
  display: flex;
  gap: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border);
}

.reset-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  background: var(--bg);
  color: var(--text-secondary);
  border: 1.5rpx solid var(--border);
  border-radius: 40rpx;
  font-size: 28rpx;
}

.confirm-btn {
  flex: 2;
  text-align: center;
  padding: 18rpx 0;
  background: #9b59b6;
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
}

/* ===== 统计条 ===== */
.stats-bar {
  padding: 16rpx 24rpx;
  background: var(--surface);
}

.stats-text {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* ===== 服务列表 ===== */
.content-list {
  padding: 20rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.service-card {
  display: flex;
  background: var(--surface);
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.card-cover {
  width: 220rpx;
  height: 180rpx;
  flex-shrink: 0;
  background: var(--border);
}

.card-body {
  flex: 1;
  padding: 16rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.service-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.service-tags {
  display: flex;
  gap: 8rpx;
  margin: 8rpx 0;
}

.mini-tag {
  font-size: 20rpx;
  background: rgba(231, 76, 60, 0.1);
  color: #9b59b6;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
}

.provider-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.provider-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--border);
}

.provider-name {
  font-size: 22rpx;
  color: var(--text-secondary);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.provider-level {
  font-size: 20rpx;
  color: var(--primary);
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.service-price {
  font-size: 32rpx;
  font-weight: 700;
  color: #9b59b6;
}

.service-rating {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* ===== 导师网格 ===== */
.mentor-grid {
  padding: 20rpx 24rpx;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.mentor-card {
  background: var(--surface);
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.mentor-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  margin-bottom: 16rpx;
  background: var(--border);
}

.mentor-info {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.mentor-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 4rpx;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mentor-level {
  font-size: 22rpx;
  color: #9b59b6;
  margin-bottom: 4rpx;
}

.mentor-school {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-bottom: 8rpx;
}

.mentor-tags {
  display: flex;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.mentor-footer {
  display: flex;
  gap: 16rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}

/* ===== 加载/空状态 ===== */
.loading-row {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
  gap: 16rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid var(--border);
  border-top-color: #9b59b6;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
  gap: 12rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
}

.empty-sub {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.bottom-tip {
  text-align: center;
  padding: 32rpx 0 16rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}
