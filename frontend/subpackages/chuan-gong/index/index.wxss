/* 传功授法 - 首页样式 */
.page {
  min-height: 100vh;
  background: var(--bg);
  padding: 24rpx 24rpx 140rpx;
}

/* ===== 搜索栏 ===== */
.search-bar {
  background: #fff;
  border-radius: 48rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--border);
}

.search-hint {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.search-icon {
  font-size: 28rpx;
}

.search-placeholder {
  font-size: 28rpx;
  color: var(--text-secondary);
}

/* ===== 区块通用 ===== */
.section {
  background: var(--surface);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
}

.section-more {
  font-size: 26rpx;
  color: var(--primary);
}

/* ===== 科目网格 ===== */
.subject-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.subject-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 16rpx;
  background: var(--bg);
  border-radius: 16rpx;
  transition: transform 0.2s, box-shadow 0.2s;
}

.subject-card:active {
  transform: scale(0.95);
}

.subject-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.subject-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 4rpx;
}

.subject-count {
  font-size: 22rpx;
  color: var(--text-secondary);
}

/* ===== 类型横向滚动 ===== */
.type-scroll {
  white-space: nowrap;
}

.type-list {
  display: inline-flex;
  gap: 16rpx;
  padding: 4rpx 0;
}

.type-tag {
  display: inline-flex;
  align-items: center;
  padding: 14rpx 28rpx;
  background: var(--bg);
  border: 1.5rpx solid var(--border);
  border-radius: 32rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  white-space: nowrap;
  transition: all 0.2s;
}

.type-tag.active {
  background: #9b59b6;
  border-color: #9b59b6;
  color: #fff;
}

/* ===== 导师横向滚动 ===== */
.mentor-scroll {
  white-space: nowrap;
}

.mentor-list {
  display: inline-flex;
  gap: 20rpx;
  padding: 4rpx 0;
}

.mentor-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 200rpx;
  padding: 20rpx;
  background: var(--bg);
  border-radius: 16rpx;
}

.mentor-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  margin-bottom: 12rpx;
  background: var(--border);
}

.mentor-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

.mentor-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 4rpx;
  max-width: 160rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mentor-level {
  font-size: 22rpx;
  color: var(--primary);
  margin-bottom: 4rpx;
}

.mentor-rating {
  font-size: 22rpx;
  color: var(--text-secondary);
}

/* ===== 服务列表 ===== */
.service-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.service-card {
  display: flex;
  background: var(--bg);
  border-radius: 16rpx;
  overflow: hidden;
  transition: transform 0.2s;
}

.service-card:active {
  transform: scale(0.98);
}

.service-cover {
  width: 200rpx;
  height: 160rpx;
  flex-shrink: 0;
  background: var(--border);
}

.service-body {
  flex: 1;
  padding: 16rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.service-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.service-tags {
  display: flex;
  gap: 8rpx;
  margin: 8rpx 0;
}

.mini-tag {
  font-size: 20rpx;
  background: rgba(231, 76, 60, 0.1);
  color: #9b59b6;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
}

.service-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.service-price {
  font-size: 32rpx;
  font-weight: 700;
  color: #9b59b6;
}

.service-rating {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
  gap: 16rpx;
}

.empty-img {
  width: 200rpx;
  height: 200rpx;
  opacity: 0.7;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
}

.empty-sub {
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* ===== 发布悬浮按钮 ===== */
.publish-fab {
  position: fixed;
  right: 32rpx;
  bottom: 140rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #9b59b6, #8e44ad);
  color: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 28rpx rgba(155, 89, 182, 0.4);
  z-index: 100;
}

.publish-fab::before {
  content: '';
  position: absolute;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(155, 89, 182, 0.3);
  animation: fab-pulse 2s infinite;
}

@keyframes fab-pulse {
  0% { transform: scale(1); opacity: 0.8; }
  100% { transform: scale(1.3); opacity: 0; }
}

.fab-icon {
  font-size: 40rpx;
}

.fab-label {
  font-size: 18rpx;
  font-weight: 500;
  margin-top: 2rpx;
}

.safe-area-bottom {
  height: env(safe-area-inset-bottom);
}
