/* 联袂问道 - 首页样式 */
.page {
  min-height: 100vh;
  background: var(--bg);
  padding: 24rpx 24rpx 140rpx;
}

/* ===== Banner ===== */
.banner {
  background: linear-gradient(135deg, #9b59b6, #8e44ad);
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  color: #fff;
}

.banner-title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.banner-sub {
  font-size: 26rpx;
  opacity: 0.9;
}

/* ===== 区块 ===== */
.section {
  background: var(--surface);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
}

.section-more {
  font-size: 26rpx;
  color: var(--primary);
}

/* ===== 分类网格 ===== */
.category-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.category-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 12rpx;
  background: var(--bg);
  border-radius: 16rpx;
}

.category-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.category-name {
  font-size: 24rpx;
  color: var(--text);
}

/* ===== 课题列表 ===== */
.team-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.team-card {
  background: var(--bg);
  border-radius: 16rpx;
  padding: 20rpx;
}

.team-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.team-category {
  font-size: 22rpx;
  color: var(--primary);
  background: rgba(155, 89, 182, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
}

.team-status {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
}

.team-status.recruiting {
  color: #9b59b6;
  background: rgba(39, 174, 96, 0.1);
}

.team-status.full {
  color: var(--text-secondary);
  background: var(--border);
}

.team-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 8rpx;
}

.team-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.team-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 22rpx;
  color: var(--text-secondary);
}

.member-icon {
  margin-right: 4rpx;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
  gap: 12rpx;
}

.empty-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
}

.empty-sub {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* ===== 发布按钮 ===== */
.publish-btn {
  position: fixed;
  right: 40rpx;
  bottom: 140rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx 36rpx;
  background: linear-gradient(135deg, #9b59b6, #8e44ad);
  color: #fff;
  border-radius: 48rpx;
  box-shadow: 0 8rpx 28rpx rgba(155, 89, 182, 0.4);
  z-index: 100;
}

.publish-icon {
  font-size: 32rpx;
  font-weight: 300;
}

.publish-text {
  font-size: 28rpx;
  font-weight: 600;
}
