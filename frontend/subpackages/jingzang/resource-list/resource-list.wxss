/* 道藏天阁 - 资源列表样式 */
.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #faf7ff;
  padding-bottom: 0;
}

/* 导航栏 */
.nav-bar {
  background: linear-gradient(135deg, #9b59b6, #7d3c98);
  padding: 20rpx 30rpx;
}
.nav-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.nav-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
}
.nav-actions {
  display: flex;
  gap: 20rpx;
}
.nav-btn {
  font-size: 28rpx;
  color: #fff;
  padding: 8rpx 16rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 20rpx;
}

/* 视图切换标签 */
.view-tabs {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #eee;
  padding: 0 20rpx;
}
.tab-item {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #888;
  padding: 24rpx 0;
  border-bottom: 4rpx solid transparent;
  transition: all 0.2s;
}
.tab-item.active {
  color: #9b59b6;
  border-bottom-color: #9b59b6;
  font-weight: 600;
}

/* 分类横向滚动 */
.category-bar {
  background: #fff;
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.category-scroll {
  white-space: nowrap;
  width: 100%;
}
.category-chip {
  display: inline-block;
  padding: 10rpx 28rpx;
  margin-right: 16rpx;
  font-size: 26rpx;
  color: #666;
  background: #f5f0fa;
  border-radius: 30rpx;
  border: 1rpx solid transparent;
}
.category-chip.active {
  color: #9b59b6;
  background: rgba(155,89,182,0.1);
  border-color: #9b59b6;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #fff;
  gap: 16rpx;
}
.search-input {
  flex: 1;
  background: #f5f0fa;
  border-radius: 40rpx;
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  color: #333;
}
.search-btn {
  font-size: 28rpx;
  color: #9b59b6;
  font-weight: 600;
  padding: 0 8rpx;
}

/* 结果统计 */
.result-summary {
  padding: 16rpx 30rpx;
  font-size: 24rpx;
  color: #999;
  background: #faf7ff;
}

/* 资源列表 */
.resource-list {
  padding: 20rpx 30rpx;
  flex: 1;
  overflow-y: auto;
}

/* 资源卡片 */
.resource-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}
.resource-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.resource-category {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  background: rgba(155,89,182,0.1);
  color: #9b59b6;
  border-radius: 12rpx;
}
.resource-date {
  font-size: 22rpx;
  color: #aaa;
}
.resource-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
  line-height: 1.4;
}
.resource-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 16rpx;
}
.resource-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.resource-author {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.author-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #eee;
}
.author-name {
  font-size: 24rpx;
  color: #999;
}
.resource-stats {
  display: flex;
  gap: 20rpx;
}
.stat-eye, .stat-like {
  font-size: 24rpx;
  color: #aaa;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 120rpx 0;
}
.empty-icon {
  display: block;
  font-size: 100rpx;
  margin-bottom: 24rpx;
}
.empty-text {
  display: block;
  font-size: 30rpx;
  color: #999;
  margin-bottom: 32rpx;
}
.empty-btn {
  display: inline-block;
  font-size: 28rpx;
  color: #fff;
  background: #9b59b6;
  padding: 16rpx 48rpx;
  border-radius: 40rpx;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 30rpx 0;
  font-size: 26rpx;
  color: #aaa;
}
.no-more {
  color: #ccc;
}

/* 发布按钮 */
.fab {
  position: fixed;
  bottom: 60rpx;
  right: 40rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #9b59b6, #7d3c98);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(155,89,182,0.4);
  z-index: 100;
}
