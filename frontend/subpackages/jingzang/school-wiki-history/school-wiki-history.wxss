/* subpackages/jingzang/school-wiki-history/school-wiki-history.wxss */
.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #faf7ff;
}
.nav-bar {
  background: linear-gradient(135deg, #9b59b6, #7d3c98);
  padding: 20rpx 30rpx;
  flex-shrink: 0;
}
.nav-inner { display: flex; align-items: center; gap: 20rpx; }
.nav-back { font-size: 36rpx; color: #fff; }
.nav-title { font-size: 32rpx; font-weight: 600; color: #fff; }
.history-list {
  flex: 1;
  padding: 20rpx 24rpx;
  overflow-y: auto;
}
.history-item {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #ede8f3;
}
.history-q {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 10rpx;
}
.history-a {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 10rpx;
}
.history-time {
  font-size: 22rpx;
  color: #aaa;
}
.empty-state {
  text-align: center;
  padding: 120rpx 0;
}
.empty-icon { display: block; font-size: 80rpx; margin-bottom: 24rpx; }
.empty-text { font-size: 28rpx; color: #aaa; }
.load-more {
  text-align: center;
  padding: 20rpx 0;
  font-size: 24rpx;
  color: #aaa;
}
