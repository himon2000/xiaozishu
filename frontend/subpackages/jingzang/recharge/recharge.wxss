/* ===== 基础 ===== */
page {
  background: #f5f0fa;
  min-height: 100%;
}
.page {
  padding: 24rpx 24rpx 200rpx;
  min-height: 100vh;
}

/* ===== 余额卡片 ===== */
.balance-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #9b59b6, #7d3c98);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  color: #fff;
}
.balance-icon {
  font-size: 64rpx;
  margin-right: 24rpx;
}
.balance-info {
  flex: 1;
}
.balance-label {
  display: block;
  font-size: 26rpx;
  opacity: 0.85;
  margin-bottom: 8rpx;
}
.balance-value {
  display: block;
  font-size: 52rpx;
  font-weight: bold;
  line-height: 1.2;
}
.balance-unit {
  font-size: 28rpx;
  opacity: 0.85;
}
.balance-tip {
  font-size: 22rpx;
  background: rgba(255,255,255,0.2);
  padding: 6rpx 14rpx;
  border-radius: 20rpx;
}

/* ===== 区块 ===== */
.section {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 28rpx 24rpx;
  margin-bottom: 20rpx;
}
.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 6rpx;
}
.section-desc {
  display: block;
  font-size: 24rpx;
  color: #999;
}

/* ===== 套餐网格 ===== */
.package-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  margin-top: 20rpx;
}
.package-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 12rpx 20rpx;
  text-align: center;
  border: 2rpx solid #eee;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}
.package-item.selected {
  border-color: #9b59b6;
  background: #f9f0fc;
}
.package-tag-wrap {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  height: 40rpx;
  background: linear-gradient(135deg, #e74c3c, #c0392b);
  display: flex;
  align-items: center;
  justify-content: center;
}
.package-tag {
  color: #fff;
  font-size: 18rpx;
  font-weight: bold;
  line-height: 1;
}
.package-icon {
  font-size: 36rpx;
  margin-top: 8rpx;
  margin-bottom: 4rpx;
}
.package-stones {
  font-size: 34rpx;
  font-weight: bold;
  color: #9b59b6;
  line-height: 1.2;
}
.package-label {
  font-size: 20rpx;
  color: #999;
}
.package-price {
  font-size: 26rpx;
  color: #333;
  font-weight: 600;
  margin-top: 4rpx;
}

/* ===== 自定义金额 ===== */
.custom-wrap {
  display: flex;
  align-items: center;
  border: 2rpx solid #eee;
  border-radius: 16rpx;
  padding: 0 24rpx;
  height: 88rpx;
  margin-top: 12rpx;
  box-sizing: border-box;
}
.custom-prefix {
  font-size: 36rpx;
  color: #9b59b6;
  font-weight: bold;
  margin-right: 8rpx;
}
.custom-input {
  flex: 1;
  font-size: 30rpx;
  height: 88rpx;
  line-height: 88rpx;
}
.custom-hint {
  display: block;
  font-size: 24rpx;
  color: #9b59b6;
  margin-top: 12rpx;
  text-align: center;
}

/* ===== 协议 ===== */
.agreement-row {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.agreement-label {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  font-size: 24rpx;
}
.agreement-text {
  color: #999;
  margin-left: 8rpx;
}
.agreement-link {
  color: #9b59b6;
  margin-left: 4rpx;
}

/* ===== 底部栏 ===== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  border-top: 1rpx solid #eee;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.05);
  z-index: 100;
  box-sizing: border-box;
}
.total-info {
  flex: 1;
}
.total-label {
  font-size: 26rpx;
  color: #666;
}
.total-price {
  font-size: 36rpx;
  font-weight: bold;
  color: #e74c3c;
}
.total-stones {
  font-size: 24rpx;
  color: #9b59b6;
}
.recharge-btn {
  background: linear-gradient(135deg, #9b59b6, #7d3c98);
  color: #fff;
  font-size: 30rpx;
  font-weight: bold;
  padding: 0 48rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(155,89,182,0.4);
}
