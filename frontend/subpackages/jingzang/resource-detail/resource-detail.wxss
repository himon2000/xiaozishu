/* subpackages/jingzang/resource-detail/resource-detail.wxss */
.page {
  min-height: 100vh;
  background: #faf7ff;
}

/* 导航栏 */
.nav-bar {
  background: linear-gradient(135deg, #9b59b6, #7d3c98);
  padding: 20rpx 30rpx;
}
.nav-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.nav-back {
  font-size: 36rpx;
  color: #fff;
  padding: 8rpx;
}
.nav-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}
.nav-share {
  font-size: 28rpx;
  color: #fff;
  padding: 8rpx 16rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 20rpx;
}

/* 加载状态 */
.loading-state, .error-state {
  text-align: center;
  padding: 120rpx 0;
  font-size: 28rpx;
  color: #999;
}
.back-btn {
  display: inline-block;
  margin-top: 24rpx;
  padding: 16rpx 48rpx;
  background: #9b59b6;
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
}

/* 封面图 */
.cover-image {
  width: 100%;
  display: block;
}

/* 资源内容 */
.resource-content {
  padding: 24rpx 30rpx;
}
.resource-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.resource-category {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  background: rgba(155, 89, 182, 0.1);
  color: #9b59b6;
  border-radius: 12rpx;
}
.resource-date {
  font-size: 22rpx;
  color: #aaa;
}
.resource-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
  line-height: 1.3;
  margin-bottom: 24rpx;
}

/* 作者卡片 */
.author-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #ede8f3;
}
.author-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #eee;
}
.author-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.author-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}
.author-school {
  font-size: 22rpx;
  color: #999;
}

/* 正文 */
.main-content {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #ede8f3;
}
.content-text {
  font-size: 28rpx;
  color: #444;
  line-height: 1.8;
}

/* 标签 */
.tags-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}
.tag {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  background: rgba(155, 89, 182, 0.1);
  color: #7d3c98;
  border-radius: 20rpx;
}

/* 操作栏 */
.action-bar {
  display: flex;
  justify-content: space-around;
  padding: 20rpx 0;
  border-top: 1rpx solid #ede8f3;
  border-bottom: 1rpx solid #ede8f3;
  margin-bottom: 30rpx;
}
.action-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
}
.action-count {
  font-size: 26rpx;
  color: #666;
}

/* 评论区域 */
.comments-section {
  padding: 0 30rpx 160rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #ede8f3;
  margin-bottom: 20rpx;
}
.comment-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.comment-item {
  display: flex;
  gap: 16rpx;
}
.comment-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #eee;
  flex-shrink: 0;
}
.comment-body {
  flex: 1;
}
.comment-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 6rpx;
}
.comment-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
}
.comment-time {
  font-size: 22rpx;
  color: #aaa;
}
.comment-text {
  font-size: 26rpx;
  color: #555;
  line-height: 1.5;
}
.empty-comments {
  text-align: center;
  padding: 60rpx 0;
  font-size: 26rpx;
  color: #aaa;
}
.load-more {
  text-align: center;
  padding: 20rpx 0;
  font-size: 24rpx;
  color: #aaa;
}

/* 评论输入栏 */
.comment-input-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: #fff;
  border-top: 1rpx solid #ede8f3;
  z-index: 100;
}
.comment-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  background: #f5f0fa;
  border-radius: 36rpx;
  font-size: 28rpx;
  color: #333;
}
.comment-submit {
  padding: 0 32rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: linear-gradient(135deg, #9b59b6, #7d3c98);
  color: #fff;
  border-radius: 36rpx;
  font-size: 28rpx;
  font-weight: 600;
}
