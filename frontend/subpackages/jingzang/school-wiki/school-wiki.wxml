<!-- subpackages/jingzang/school-wiki/school-wiki.wxml -->
<view class="page">
  <!-- 导航栏 -->
  <view class="nav-bar safe-area-top">
    <view class="nav-inner">
      <view class="nav-back" bindtap="onBack">←</view>
      <text class="nav-title">🏫 万宗宝鉴</text>
      <view class="nav-history" bindtap="onShowHistory">历史</view>
    </view>
  </view>

  <!-- 简介卡片 -->
  <view class="intro-card">
    <text class="intro-title">高校百科 AI 助手</text>
    <text class="intro-desc">查询已接入高校的专业、课程、招生政策与科研知识。当前为知识图谱规则检索，答案附官网来源；未调用语言模型。</text>
    <text class="service-error" wx:if="{{schoolError}}" bindtap="loadSchools">{{schoolError}} · 点击重试</text>
  </view>

  <!-- 高校选择 -->
  <view class="school-section">
    <view class="section-label">选择已接入高校</view>
    <scroll-view scroll-x class="school-scroll">
      <view
        class="school-chip {{selectedSchool === item.name ? 'selected' : ''}}"
        wx:for="{{schools}}"
        wx:key="name"
        bindtap="onSelectSchool"
        data-name="{{item.name}}"
      >
        {{item.name}}
      </view>
    </scroll-view>
  </view>

  <view class="knowledge-toggle" bindtap="onToggleKnowledge">{{showKnowledge ? '返回图谱问答' : '浏览高校知识图谱 →'}}</view>

  <!-- 快捷问题 -->
  <view class="quick-questions" wx:if="{{!showKnowledge}}">
    <text class="section-label">快捷问题</text>
    <view class="question-chips">
      <view
        class="q-chip"
        wx:for="{{quickQuestions}}"
        wx:key="index"
        bindtap="onQuickQuestion"
        data-q="{{item}}"
      >{{item}}</view>
    </view>
  </view>

  <!-- 问答区 -->
  <scroll-view scroll-y class="qa-area" wx:if="{{!showKnowledge}}">
    <!-- AI 回复 -->
    <view class="ai-intro" wx:if="{{messages.length === 0 && !loading}}">
      <text class="ai-avatar">🤖</text>
      <view class="ai-bubble">
        <text>请选择已接入高校，再查询专业、课程、专修方向、招生政策或科研项目。\n未收录不代表不存在；招生政策不能替代招生人数计划、报名资格或录取概率。</text>
      </view>
    </view>

    <!-- 消息列表 -->
    <view wx:for="{{messages}}" wx:key="index" class="message-item {{item.role}}">
      <text class="msg-avatar">{{item.role === 'user' ? '🧑' : '🤖'}}</text>
      <view class="msg-bubble">
        <text class="msg-text">{{item.content}}</text>
        <text class="evidence-status" wx:if="{{item.evidenceStatus}}">{{item.evidenceStatus === 'supported' ? '已匹配官网证据' : '图谱证据不足'}}</text>
        <view class="source-card" wx:for="{{item.sources}}" wx:for-item="source" wx:key="id">
          <text class="source-title">{{source.title}}</text>
          <text>{{source.locator}}</text>
          <text>核验日期：{{source.reviewed_on}}</text>
          <text class="source-copy" bindtap="onCopySource" data-url="{{source.url}}">复制官网链接</text>
        </view>
        <text class="answer-caveat" wx:for="{{item.caveats}}" wx:for-item="caveat" wx:key="*this">{{caveat}}</text>
        <text class="answer-caveat" wx:if="{{item.historyWarning}}">{{item.historyWarning}}</text>
        <text class="msg-time" wx:if="{{item.time}}">{{item.time}}</text>
      </view>
    </view>

    <!-- 加载指示 -->
    <view class="loading-msg" wx:if="{{loading}}">
      <text class="msg-avatar">🤖</text>
      <view class="loading-dots">
        <text>思考中</text>
        <view class="dot"></view>
        <view class="dot"></view>
        <view class="dot"></view>
      </view>
    </view>
  </scroll-view>

  <scroll-view scroll-y class="qa-area" wx:else>
    <view class="question-chips">
      <view wx:for="{{topics}}" wx:key="id" class="q-chip {{topic === item.id ? 'topic-active' : ''}}" bindtap="onTopic" data-id="{{item.id}}">{{item.label}}</view>
    </view>
    <text class="answer-caveat">官网公开知识首版；不含实时成绩、课表、经费或审批记录。</text>
    <text wx:if="{{knowledgeLoading}}">读取图谱中...</text>
    <text class="service-error" wx:if="{{knowledgeError}}" bindtap="loadKnowledge">{{knowledgeError}}</text>
    <text wx:if="{{!knowledgeLoading && !knowledgeError && knowledge.length === 0}}">当前分类暂未收录记录。</text>
    <view class="knowledge-card" wx:for="{{knowledge}}" wx:key="id">
      <text class="source-title">{{item.name}}</text>
      <text wx:if="{{item.properties.status}}">{{item.properties.status}}</text>
      <text wx:if="{{item.properties.execution_status}}">状态：{{item.properties.execution_status}}</text>
    </view>
    <view class="source-card" wx:for="{{knowledgeSources}}" wx:key="id">
      <text class="source-title">{{item.title}}</text>
      <text>核验日期：{{item.reviewed_on}}</text>
      <text class="source-copy" bindtap="onCopySource" data-url="{{item.url}}">复制官网链接</text>
    </view>
  </scroll-view>

  <!-- 输入区 -->
  <view class="input-area safe-area-bottom" wx:if="{{!showKnowledge}}">
    <input
      class="question-input"
      placeholder="输入关于高校的问题..."
      bindconfirm="onAsk"
      bindinput="onInput"
      value="{{inputText}}"
      maxlength="1000"
    />
    <view class="ask-btn" bindtap="onAsk">提问</view>
  </view>

  <!-- 悬浮发布需求按钮 -->
  <view class="fab" bindtap="onPublishRequest">
    <text class="fab-icon">📝</text>
    <text class="fab-text">发布需求</text>
  </view>
</view>
