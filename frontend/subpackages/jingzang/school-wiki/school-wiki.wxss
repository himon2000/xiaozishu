/* subpackages/jingzang/school-wiki/school-wiki.wxss */
.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #faf7ff;
}

/* 导航栏 */
.nav-bar {
  background: linear-gradient(135deg, #9b59b6, #7d3c98);
  padding: 20rpx 30rpx;
  flex-shrink: 0;
}
.nav-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.nav-back {
  font-size: 36rpx;
  color: #fff;
  padding: 8rpx;
}
.nav-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}
.nav-history {
  font-size: 26rpx;
  color: #fff;
  padding: 8rpx 16rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 20rpx;
}

/* 简介卡片 */
.intro-card {
  background: rgba(155, 89, 182, 0.1);
  border: 1rpx solid rgba(155, 89, 182, 0.2);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin: 20rpx 24rpx;
  flex-shrink: 0;
}
.intro-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #7d3c98;
  margin-bottom: 8rpx;
}
.intro-desc {
  display: block;
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

/* 高校选择 */
.school-section {
  padding: 0 24rpx 16rpx;
  flex-shrink: 0;
}
.section-label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
}
.school-scroll {
  white-space: nowrap;
  width: 100%;
}
.school-chip {
  display: inline-block;
  padding: 10rpx 24rpx;
  margin-right: 12rpx;
  font-size: 26rpx;
  color: #666;
  background: #fff;
  border-radius: 30rpx;
  border: 1rpx solid #ede8f3;
  white-space: nowrap;
}
.school-chip.selected {
  background: rgba(155, 89, 182, 0.15);
  border-color: #9b59b6;
  color: #7d3c98;
  font-weight: 600;
}

/* 快捷问题 */
.quick-questions {
  padding: 0 24rpx 16rpx;
  flex-shrink: 0;
}
.question-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.q-chip {
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  color: #9b59b6;
  background: rgba(155, 89, 182, 0.08);
  border-radius: 20rpx;
  border: 1rpx solid rgba(155, 89, 182, 0.2);
}

/* 问答区域 */
.qa-area {
  flex: 1;
  padding: 20rpx 24rpx;
  overflow-y: auto;
}

/* AI 引导 */
.ai-intro {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 30rpx;
}
.ai-avatar, .msg-avatar {
  font-size: 40rpx;
  flex-shrink: 0;
}
.ai-bubble, .msg-bubble {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  border: 1rpx solid #ede8f3;
}
.ai-bubble {
  font-size: 26rpx;
  color: #444;
  line-height: 1.7;
  white-space: pre-wrap;
}

/* 消息 */
.message-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.message-item.user {
  flex-direction: row-reverse;
}
.msg-bubble {
  max-width: 75%;
}
.msg-text {
  font-size: 26rpx;
  color: #333;
  line-height: 1.6;
  white-space: pre-wrap;
}
.message-item.ai .msg-bubble {
  background: #fff;
  border-color: #ede8f3;
}
.message-item.user .msg-bubble {
  background: rgba(155, 89, 182, 0.15);
  border-color: rgba(155, 89, 182, 0.3);
}
.msg-time {
  display: block;
  font-size: 20rpx;
  color: #aaa;
  margin-top: 8rpx;
  text-align: right;
}

/* 加载 */
.loading-msg {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.loading-dots {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  border: 1rpx solid #ede8f3;
  font-size: 26rpx;
  color: #999;
}
.dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #9b59b6;
  animation: bounce 1.4s infinite ease-in-out;
}
.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }
@keyframes bounce {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.5; }
  40% { transform: scale(1); opacity: 1; }
}

/* 输入区 */
.input-area {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: #fff;
  border-top: 1rpx solid #ede8f3;
  flex-shrink: 0;
}
.question-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  background: #f5f0fa;
  border-radius: 36rpx;
  font-size: 28rpx;
  color: #333;
}
.ask-btn {
  padding: 0 32rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: linear-gradient(135deg, #9b59b6, #7d3c98);
  color: #fff;
  border-radius: 36rpx;
  font-size: 28rpx;
  font-weight: 600;
}

/* 悬浮发布需求按钮 */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(140rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  background: linear-gradient(135deg, #9b59b6, #7d3c98);
  color: #fff;
  padding: 20rpx 28rpx;
  border-radius: 40rpx;
  box-shadow: 0 6rpx 24rpx rgba(155, 89, 182, 0.45);
  z-index: 999;
}
.fab-icon {
  font-size: 40rpx;
  line-height: 1;
}
.fab-text {
  font-size: 22rpx;
  font-weight: 600;
  white-space: nowrap;
}
