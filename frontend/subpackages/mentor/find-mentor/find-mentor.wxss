/* subpackages/mentor/find-mentor/find-mentor.wxss */
.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #faf7ff;
}

.nav-bar {
  background: linear-gradient(135deg, #9b59b6, #7d3c98);
  padding: 20rpx 30rpx;
  flex-shrink: 0;
}
.nav-inner {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.nav-back {
  font-size: 36rpx;
  color: #fff;
}
.nav-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}

/* 收益卡片 */
.benefit-card {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin: 20rpx 24rpx;
  padding: 20rpx;
  background: rgba(155, 89, 182, 0.08);
  border-radius: 12rpx;
  border: 1rpx solid rgba(155, 89, 182, 0.15);
  flex-shrink: 0;
}
.benefit-icon { font-size: 36rpx; }
.benefit-text { display: flex; flex-direction: column; gap: 6rpx; }
.benefit-title { font-size: 28rpx; font-weight: 600; color: #7d3c98; }
.benefit-desc { font-size: 24rpx; color: #666; line-height: 1.5; }

/* 导师类型切换 Tab */
.type-tabs {
  display: flex;
  padding: 16rpx 24rpx;
  gap: 16rpx;
  background: #fff;
  border-bottom: 1rpx solid #ede8f3;
  flex-shrink: 0;
}
.type-tab {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 28rpx;
  color: #888;
  border-radius: 30rpx;
  background: #f5f0fa;
  transition: all 0.2s;
}
.type-tab.active {
  background: linear-gradient(135deg, #9b59b6, #7d3c98);
  color: #fff;
  font-weight: 600;
}

/* 导师类型徽章 */
.mentor-type-badge {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 6rpx;
}
.type-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
  font-weight: 600;
}
.enterprise-tag {
  background: rgba(52, 152, 219, 0.12);
  color: #2980b9;
}
.academic-tag {
  background: rgba(155, 89, 182, 0.12);
  color: #7d3c98;
}
.direction-tag {
  font-size: 20rpx;
  color: #999;
  padding: 4rpx 8rpx;
}

/* 导师列表 */
.mentor-list {
  flex: 1;
  padding: 0 24rpx 24rpx;
  overflow-y: auto;
}

/* 骨架屏 */
.skeleton-list { display: flex; flex-direction: column; gap: 20rpx; }
.skeleton-card {
  height: 200rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  border-radius: 16rpx;
  animation: shimmer 1.5s infinite;
}
@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* 导师卡片 */
.mentor-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  display: flex;
  gap: 20rpx;
  border: 1rpx solid #ede8f3;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.mentor-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #eee;
  flex-shrink: 0;
}
.mentor-info {
  flex: 1;
  min-width: 0;
}
.mentor-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 6rpx;
  flex-wrap: wrap;
}
.mentor-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}
.level-badge {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  font-weight: 600;
}
.mentor-school {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 6rpx;
}
.mentor-tagline {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.mentor-stats {
  display: flex;
  gap: 20rpx;
  margin-bottom: 10rpx;
}
.stat-item {
  font-size: 22rpx;
  color: #888;
}
.specialties {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}
.specialty-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  background: #f5f0fa;
  color: #7d3c98;
  border-radius: 12rpx;
}

/* 申请传承按钮 */
.apply-btn {
  align-self: center;
  padding: 12rpx 28rpx;
  background: linear-gradient(135deg, #9b59b6, #7d3c98);
  color: #fff;
  border-radius: 30rpx;
  font-size: 26rpx;
  font-weight: 600;
  flex-shrink: 0;
}

/* 空/加载状态 */
.empty-state {
  text-align: center;
  padding: 120rpx 0;
}
.empty-icon { display: block; font-size: 80rpx; margin-bottom: 24rpx; }
.empty-text { font-size: 28rpx; color: #aaa; }
.load-more {
  text-align: center;
  padding: 30rpx 0;
  font-size: 24rpx;
  color: #aaa;
}
.no-more { color: #ccc; }
