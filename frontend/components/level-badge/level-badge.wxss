/* components/level-badge/level-badge.wxss */
.level-badge {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  border: 2rpx solid;
  border-radius: 20rpx;
  position: relative;
  overflow: hidden;
}

.level-badge.size-sm {
  padding: 4rpx 12rpx;
  font-size: 20rpx;
}

.level-badge.size-md {
  padding: 6rpx 16rpx;
  font-size: 24rpx;
}

.level-badge.size-lg {
  padding: 12rpx 24rpx;
  font-size: 30rpx;
}

.level-icon { }

.level-name {
  font-weight: 600;
}

.level-glow {
  position: absolute;
  inset: 0;
  pointer-events: none;
}
