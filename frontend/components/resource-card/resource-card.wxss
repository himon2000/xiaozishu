/* components/resource-card/resource-card.wxss */
.resource-card {
  background: #13132e;
  border: 1rpx solid #1e1e4a;
  border-radius: 16rpx;
  overflow: hidden;
}

.resource-card.compact { display: flex; flex-direction: row; }

.cover {
  width: 100%;
  height: 200rpx;
  background: #1a1a3e;
}

.resource-card.compact .cover { width: 140rpx; height: 140rpx; flex-shrink: 0; }

.placeholder { display: flex; align-items: center; justify-content: center; }
.ph-icon { font-size: 60rpx; }

.body { padding: 20rpx; }

.resource-card.compact .body { flex: 1; padding: 16rpx; display: flex; flex-direction: column; justify-content: center; }

.meta { display: flex; align-items: center; gap: 10rpx; margin-bottom: 10rpx; }

.type { font-size: 20rpx; color: #6a6a9e; }

.access { font-size: 20rpx; padding: 2rpx 10rpx; border-radius: 10rpx; }
.access.free { color: #00cc44; background: rgba(0,204,68,0.1); }
.access.points { color: #ffd700; background: rgba(255,215,0,0.1); }
.access.paid { color: #4499ff; background: rgba(68,153,255,0.1); }

.title {
  display: block;
  font-size: 28rpx;
  color: #e0e0ff;
  font-weight: 600;
  margin-bottom: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.resource-card.compact .title { -webkit-line-clamp: 1; margin-bottom: 6rpx; }

.tags { display: flex; flex-wrap: wrap; gap: 6rpx; margin-bottom: 10rpx; }
.tag { font-size: 20rpx; padding: 2rpx 10rpx; background: rgba(68,153,255,0.08); color: #4499ff; border-radius: 10rpx; }

.footer { display: flex; align-items: center; gap: 16rpx; }
.views, .likes { font-size: 22rpx; color: #5555aa; }
.featured { font-size: 20rpx; color: #ffd700; padding: 2rpx 10rpx; background: rgba(255,215,0,0.1); border-radius: 10rpx; }
